                            <ui:Button text="Craft" name="btn-craft-specialist" style="flex-shrink: 1; width: 90px; height: 90px; background-color: rgb(0, 0, 0); border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 20px; color: rgb(255, 244, 232);"/>

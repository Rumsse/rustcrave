                        <ui:VisualElement name="craft-cost" style="flex-grow: 1; align-self: center; align-items: auto; flex-direction: column; flex-wrap: nowrap; justify-content: flex-start; align-content: center; height: 100px; width: 300px;">
                            <ui:VisualElement name="resource-item" class="resource-item" style="background-color: rgba(118, 105, 33, 0); justify-content: flex-start; align-content: center; flex-direction: row; flex-wrap: nowrap;">

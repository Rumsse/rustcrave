                <ui:VisualElement name="container" style="flex-grow: 1; align-self: auto; align-content: center; justify-content: center; align-items: auto; flex-wrap: wrap;">
                    <ui:VisualElement name="background" style="background-color: rgb(92, 82, 26); border-top-left-radius: 60px; border-top-right-radius: 60px; border-bottom-right-radius: 60px; border-bottom-left-radius: 60px; flex-direction: row; flex-wrap: wrap; align-self: center; align-content: center; align-items: center; flex-grow: 0; flex-shrink: 1; justify-content: flex-start; width: 685px; height: 120px;">
                        <ui:Label text="Warriors" name="unit-type" style="-unity-font-style: bold; font-size: 35px; width: 130px; height: 100px; align-self: flex-start; align-content: center; -unity-text-align: middle-center; align-items: stretch; justify-content: center; flex-direction: row; margin-left: 65px;">
                            <ui:Label text="Great at fighting" name="info" style="flex-wrap: wrap; flex-direction: column-reverse; align-self: flex-end; align-items: stretch; justify-content: flex-end; align-content: flex-end; display: flex; font-size: 10px;"/>
                        </ui:Label>
                        <ui:VisualElement name="craft-cost" style="flex-grow: 1; align-self: center; align-items: auto; flex-direction: column; flex-wrap: nowrap; justify-content: flex-start; align-content: center; height: 100px; width: 300px;">
                            <ui:VisualElement name="resource-item" class="resource-item" style="background-color: rgba(118, 105, 33, 0); justify-content: flex-start; align-content: center; flex-direction: row; flex-wrap: nowrap;">

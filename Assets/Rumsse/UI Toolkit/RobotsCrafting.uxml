<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Rumsse/UI%20Toolkit/Styles/HUD%20Style.uss?fileID=7433441132597879392&amp;guid=7b47a7b00a228194890309076bd0a8b2&amp;type=3#HUD Style"/>
    <ui:VisualElement name="robots" picking-mode="Ignore" style="flex-grow: 1; background-color: rgb(74, 63, 1); border-top-left-radius: 0%; border-bottom-left-radius: 0%; align-content: center; align-items: stretch; background-image: none; border-top-right-radius: 70px; border-bottom-right-radius: 70px; flex-wrap: wrap; align-self: center; flex-direction: row; width: 100%; height: 100%; flex-shrink: 0;">
        <ui:VisualElement name="right-bar" style="flex-grow: 1; height: 100%; width: 100%; align-items: center; align-self: center; flex-direction: column; flex-wrap: nowrap; flex-shrink: 0;">
            <ui:VisualElement name="upper-section" style="flex-grow: 1; width: 100%; height: 30%; flex-shrink: 1; align-self: auto; align-content: center; align-items: flex-start; justify-content: center; flex-direction: row;">
                <ui:Label text="ROBOTS" name="header" style="align-self: auto; align-content: center; align-items: auto; justify-content: center; font-size: 55px; -unity-text-align: middle-center; -unity-font-style: bold; width: 430px; height: 80px; margin-top: 55px;">
                    <ui:Button text="?" name="btn-info-robots" style="border-left-color: rgb(87, 83, 64); border-right-color: rgb(87, 83, 64); border-top-color: rgb(87, 83, 64); border-bottom-color: rgb(87, 83, 64); border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; align-items: flex-end; align-self: flex-end; align-content: center; flex-shrink: 1; width: 50px; height: 50px; font-size: 35px; color: rgb(0, 0, 0); background-color: rgb(94, 90, 68); margin-right: 12px; justify-content: center;"/>
                    <ui:VisualElement name="robots-info-panel" style="flex-grow: 1; position: absolute; width: 400px; height: 150px; margin-top: 40px; background-color: rgb(61, 54, 17); border-top-left-radius: 25px; border-top-right-radius: 25px; border-bottom-right-radius: 25px; border-bottom-left-radius: 25px; display: none; right: 80px; align-self: center; align-content: auto; align-items: auto;">
                        <ui:Label text="info info info info info info info info info info info info info info info" name="info-text" style="font-size: 30px; align-self: center; align-content: stretch; flex-direction: row; flex-wrap: wrap; white-space: normal; color: rgb(0, 0, 0); justify-content: space-evenly; flex-grow: 1;"/>
                    </ui:VisualElement>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement name="middle-section" style="flex-grow: 1; width: 100%; height: 100%; flex-shrink: 1; flex-direction: column; flex-wrap: wrap; align-content: flex-start;">
                <ui:VisualElement name="container" style="flex-grow: 1; align-self: auto; align-content: center; justify-content: center; align-items: auto; flex-wrap: wrap;">
                    <ui:VisualElement name="background" style="background-color: rgb(92, 82, 26); border-top-left-radius: 60px; border-top-right-radius: 60px; border-bottom-right-radius: 60px; border-bottom-left-radius: 60px; flex-direction: row; flex-wrap: wrap; align-self: center; align-content: center; align-items: center; flex-grow: 0; flex-shrink: 1; justify-content: flex-start; width: 685px; height: 120px;">
                        <ui:Label text="Miners" name="unit-type" style="-unity-font-style: bold; font-size: 35px; width: 130px; height: 100px; align-self: flex-start; align-content: center; -unity-text-align: middle-center; align-items: stretch; justify-content: center; flex-direction: row; margin-left: 65px;">
                            <ui:Label text="Great at mining" name="info" style="flex-wrap: wrap; flex-direction: column-reverse; align-self: flex-end; align-items: stretch; justify-content: flex-end; align-content: flex-end; display: flex; font-size: 10px;"/>
                        </ui:Label>
                        <ui:VisualElement name="craft-cost" style="flex-grow: 1; align-self: center; align-items: auto; flex-direction: column; flex-wrap: nowrap; justify-content: flex-start; align-content: center; height: 100px; width: 300px;">
                            <ui:VisualElement name="resource-item" class="resource-item" style="background-color: rgba(118, 105, 33, 0); justify-content: flex-start; align-content: center; flex-direction: row; flex-wrap: nowrap;">
                                <ui:VisualElement name="icon" class="resource-icon resource-icon-spark" style="width: 15%; height: 150%;"/>
                                <ui:Label text="0" name="amount" class="resource-amount"/>
                                <ui:Label text="Sparklite" name="name" class="resource-name"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="resource-item" class="resource-item" style="background-color: rgba(118, 105, 33, 0);">

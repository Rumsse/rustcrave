                            <ui:Button text="Craft" name="btn-craft-warrior" style="flex-shrink: 1; width: 90px; height: 90px; background-color: rgb(0, 0, 0); border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 20px; color: rgb(255, 244, 232);"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="container" style="flex-grow: 1; align-self: auto; align-content: center; justify-content: center; align-items: auto; flex-wrap: wrap;">
                    <ui:VisualElement name="background" style="background-color: rgb(92, 82, 26); border-top-left-radius: 60px; border-top-right-radius: 60px; border-bottom-right-radius: 60px; border-bottom-left-radius: 60px; flex-direction: row; flex-wrap: wrap; align-self: center; align-content: center; align-items: center; flex-grow: 0; flex-shrink: 1; justify-content: flex-start; width: 685px; height: 120px;">
                        <ui:Label text="Specialists" name="unit-type" style="-unity-font-style: bold; font-size: 35px; width: 130px; height: 100px; align-self: flex-start; align-content: center; -unity-text-align: middle-center; align-items: stretch; justify-content: center; flex-direction: row; margin-left: 65px;">
                            <ui:Label text="Great at their own thing" name="info" style="flex-wrap: wrap; flex-direction: column-reverse; align-self: flex-end; align-items: stretch; justify-content: flex-end; align-content: flex-end; display: flex; font-size: 10px;"/>

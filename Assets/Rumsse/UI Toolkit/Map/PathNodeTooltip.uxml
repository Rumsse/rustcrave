    <ui:VisualElement name="node-tooltip" class="animated-tooltip" style="flex-grow: 1; flex-direction: column; flex-wrap: wrap; align-self: center; align-content: center; align-items: center; justify-content: flex-start; background-color: rgb(253, 243, 230); flex-shrink: 1; flex-basis: 0%; width: 240px; height: 140px; border-top-left-radius: 17px; border-top-right-radius: 17px; border-bottom-right-radius: 17px; border-bottom-left-radius: 17px; position: absolute;">

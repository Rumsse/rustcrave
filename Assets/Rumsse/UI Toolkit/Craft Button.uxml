<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="craft-btn" style="background-color: rgb(92, 82, 26); border-top-left-radius: 60px; border-top-right-radius: 60px; border-bottom-right-radius: 60px; border-bottom-left-radius: 60px; flex-direction: row; flex-wrap: wrap; align-self: center; align-content: center; align-items: center; flex-grow: 0; flex-shrink: 1; justify-content: flex-start; width: 685px; height: 100px; top: 10px;">
        <ui:Label text="Sparking Capacitor" name="gadget-name" style="-unity-font-style: bold; font-size: 25px; width: 175px; height: 90px; align-self: center; align-content: center; -unity-text-align: upper-center; align-items: stretch; justify-content: center; flex-direction: row; margin-left: 35px; white-space: normal; padding-bottom: 0; margin-right: 30px;">
            <ui:Label text="+20 to energy" name="info" style="flex-wrap: wrap; flex-direction: row; align-self: flex-end; align-items: flex-end; justify-content: center; align-content: center; display: flex; font-size: 10px; margin-right: 2px; padding-bottom: 0; margin-bottom: 6px;"/>
        </ui:Label>
        <ui:VisualElement name="craft-cost" style="flex-grow: 1; align-self: center; align-items: center; flex-direction: column; flex-wrap: nowrap; justify-content: center; align-content: flex-start; height: 110px; width: 150px; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px;">
            <ui:VisualElement name="resource-item" class="resource-item" style="background-color: rgba(118, 105, 33, 0); justify-content: flex-start; align-content: center; flex-direction: row; flex-wrap: nowrap; width: auto; height: 100%; align-items: stretch; align-self: stretch;">
                <ui:VisualElement name="icon" class="resource-icon" style="width: 25px; height: 25px; background-color: rgb(0, 0, 0); margin-right: 10px; border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; align-self: center; align-content: center; align-items: center; justify-content: center; margin-left: 10px;"/>
                <ui:Label text="0" name="amount" class="resource-amount" style="width: 25px; align-self: center; align-items: center; justify-content: center; align-content: center; -unity-text-align: middle-center;"/>
                <ui:Label text="Sparklite" name="name" class="resource-name" style="flex-direction: row; flex-wrap: wrap; width: 120px; align-items: center; align-self: center; align-content: center; justify-content: center; -unity-text-align: middle-left;"/>
            </ui:VisualElement>
            <ui:VisualElement name="resource-item" class="resource-item" style="background-color: rgba(118, 105, 33, 0); justify-content: flex-start; align-content: center; flex-direction: row; flex-wrap: nowrap; width: auto; height: 100%; align-items: stretch; align-self: stretch;">
                <ui:VisualElement name="icon" class="resource-icon" style="width: 25px; height: 25px; background-color: rgb(0, 0, 0); margin-right: 10px; border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; align-self: center; align-content: center; align-items: center; justify-content: center; margin-left: 10px;"/>
                <ui:Label text="0" name="amount" class="resource-amount" style="width: 25px; align-self: center; align-items: center; justify-content: center; align-content: center; -unity-text-align: middle-center;"/>
                <ui:Label text="Sparklite" name="name" class="resource-name" style="flex-direction: row; flex-wrap: wrap; width: 120px; align-items: center; align-self: center; align-content: center; justify-content: center; -unity-text-align: middle-left;"/>
            </ui:VisualElement>
            <ui:VisualElement name="resource-item" class="resource-item" style="background-color: rgba(118, 105, 33, 0); justify-content: flex-start; align-content: center; flex-direction: row; flex-wrap: nowrap; width: auto; height: 100%; align-items: stretch; align-self: stretch;">
                <ui:VisualElement name="icon" class="resource-icon" style="width: 25px; height: 25px; background-color: rgb(0, 0, 0); margin-right: 10px; border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-right-radius: 7px; border-bottom-left-radius: 7px; align-self: center; align-content: center; align-items: center; justify-content: center; margin-left: 10px;"/>
                <ui:Label text="0" name="amount" class="resource-amount" style="width: 25px; align-self: center; align-items: center; justify-content: center; align-content: center; -unity-text-align: middle-center;"/>
                <ui:Label text="Sparklite" name="name" class="resource-name" style="flex-direction: row; flex-wrap: wrap; width: 120px; align-items: center; align-self: center; align-content: center; justify-content: center; -unity-text-align: middle-left;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="craft" style="flex-grow: 1; align-self: center; align-items: center; flex-direction: row; flex-wrap: nowrap; justify-content: space-around; align-content: center;">
            <ui:Button text="Craft" name="btn-craft-kinetic" style="flex-shrink: 1; width: 90px; height: 90px; background-color: rgb(0, 0, 0); border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 20px; color: rgb(255, 244, 232);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Rumsse/UI%20Toolkit/Styles/HUD%20Style.uss?fileID=7433441132597879392&amp;guid=7b47a7b00a228194890309076bd0a8b2&amp;type=3#HUD Style"/>
    <Style src="project://database/Assets/Rumsse/UI%20Toolkit/Styles/Tutorial%20Styles.uss?fileID=7433441132597879392&amp;guid=0edd93bd5a288e949b4f97a3e8f650e9&amp;type=3#Tutorial Styles"/>
    <Style src="project://database/Assets/Rumsse/UI%20Toolkit/Styles/Animation%20Types.uss?fileID=7433441132597879392&amp;guid=98464109cb086e746907c8fe0675bd8f&amp;type=3#Animation Types"/>
    <ui:VisualElement name="Root" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="top-bar" style="flex-grow: 1; align-content: center; flex-direction: row; width: 50%;">
            <ui:VisualElement name="options" style="height: 60px; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1.5%; width: 60px; background-color: rgba(0, 0, 0, 0);">
                <ui:Button text="" name="btn-options" class="button-options"/>
            </ui:VisualElement>
            <ui:VisualElement name="resource-bar" style="flex-grow: 0; flex-direction: row; align-content: center; height: 7%; flex-wrap: nowrap; align-self: flex-start; justify-content: flex-start; align-items: center; width: 50%; left: 9%;">
                <ui:VisualElement name="resource-sparklite" class="resource-item">
                    <ui:VisualElement name="icon" class="resource-icon resource-icon-spark"/>
                    <ui:Label name="amount" text="0" class="resource-amount" style="font-size: 20px; -unity-text-align: middle-center;">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="Sparklite" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Label>
                    <ui:Label text="Sparklite" name="name" class="resource-name" style="-unity-font-style: bold; font-size: 18px; -unity-text-align: middle-center;"/>
                </ui:VisualElement>
                <ui:VisualElement name="resource-scraponite" class="resource-item">
                    <ui:VisualElement name="icon" class="resource-icon resource-icon-scraponite"/>
                    <ui:Label text="0" name="amount" class="resource-amount" style="font-size: 20px; -unity-text-align: middle-center;">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="Scraponite" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Label>
                    <ui:Label text="Scraponite" name="name" class="resource-name" style="font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
                </ui:VisualElement>
                <ui:VisualElement name="resource-pulsite" class="resource-item">
                    <ui:VisualElement name="icon" class="resource-icon resource-icon-pulsite"/>
                    <ui:Label text="0" name="amount" class="resource-amount" style="font-size: 20px; -unity-text-align: middle-center;">
                        <Bindings>
                            <ui:DataBinding property="text" data-source-path="Pulsite" binding-mode="ToTarget"/>
                        </Bindings>
                    </ui:Label>
                    <ui:Label text="Pulsite" name="name" class="resource-name" style="font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-left;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="event-pop-up-container" style="flex-grow: 0; position: absolute; align-self: center; width: 550px; height: 400px; align-content: auto; justify-content: center; align-items: auto;">
            <ui:VisualElement name="event-pop-up" style="flex-grow: 1; align-self: flex-start; align-content: center; flex-direction: column; justify-content: flex-end; align-items: center; margin-left: 45px; margin-bottom: 50px;">
                <ui:VisualElement name="background-tutorial-event-highlight" class="standard-event-popup-background">
                    <ui:Button text="" name="btn-event-pop-up" style="background-color: rgba(188, 188, 188, 0); width: 350px; height: 190px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; top: 0;">
                        <ui:Label text="EVENT" name="header" style="align-self: center; align-content: center; align-items: center; font-size: 45px; -unity-text-align: upper-center; -unity-font-style: bold; top: 20px; color: rgb(151, 131, 95);"/>
                        <ui:VisualElement name="icon" style="flex-grow: 0; height: 80px; width: 80px; align-self: center; align-content: center; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; top: 12px;"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="action-buttons" style="flex-grow: 0; flex-direction: column; width: 25%; align-self: auto; align-content: auto; align-items: center; justify-content: space-between;">
            <ui:VisualElement name="upper-buttons" style="flex-grow: 1; flex-wrap: wrap; align-self: center; justify-content: flex-end; align-content: center; flex-direction: row; margin-right: 45px;">
                <ui:Button text="CRAFT" name="btn-craft" class="button"/>
                <ui:Button text="SWARM" name="btn-swarm" class="button"/>
            </ui:VisualElement>
            <ui:VisualElement name="bottom-buttons" style="flex-grow: 1; flex-wrap: wrap; align-self: center; justify-content: flex-end; align-content: center; flex-direction: column; margin-bottom: 40px;">
                <ui:Button text="CHOOSE PATH" name="btn-choose-path" class="button" style="width: 380px; height: 130px; -unity-font-style: bold; font-size: 35px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="panel-layer" picking-mode="Ignore" style="position: absolute; width: 100%; height: 100%; display: none;">
            <ui:VisualElement name="left-panel" style="position: absolute; width: 50%; height: 100%; align-self: flex-start;"/>
            <ui:VisualElement name="right-panel" style="position: absolute; width: 50%; height: 100%; align-self: flex-end;"/>
        </ui:VisualElement>
        <ui:VisualElement name="event-layer" picking-mode="Ignore" style="flex-grow: 1; position: absolute; height: 100%; width: 100%; align-self: stretch; align-content: stretch; justify-content: space-evenly; align-items: stretch;"/>
        <ui:VisualElement name="tooltip-layer" picking-mode="Ignore" style="position: absolute; width: 1920px; height: 100%; display: flex; background-color: rgba(0, 0, 0, 0); align-self: auto; align-items: stretch; align-content: auto; justify-content: flex-start; flex-direction: row; -unity-slice-right: 0;"/>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Rumsse/UI%20Toolkit/Styles/HUD%20Style.uss?fileID=7433441132597879392&amp;guid=7b47a7b00a228194890309076bd0a8b2&amp;type=3#HUD Style"/>
    <ui:VisualElement name="Root" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="top-bar" style="flex-grow: 1; align-content: center; flex-direction: row; width: 50%;">
            <ui:VisualElement name="Settings" style="height: 60px; margin-top: 1%; margin-right: 1%; margin-bottom: 1%; margin-left: 1.5%; width: 60px;">
                <ui:Button text="." style="flex-grow: 1; background-color: rgb(117, 105, 33); border-top-left-radius: 47px; border-top-right-radius: 47px; border-bottom-right-radius: 47px; border-bottom-left-radius: 47px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="resource-bar" style="flex-grow: 0; flex-direction: row; align-content: center; height: 7%; flex-wrap: nowrap; align-self: flex-start; justify-content: flex-start; align-items: center; width: 50%; left: 9%;">
                <ui:VisualElement name="resource-item" class="resource-item">
                    <ui:VisualElement name="icon" class="resource-icon"/>
                    <ui:Label text="0" name="amount" class="resource-amount"/>
                    <ui:Label text="Sparklite" name="name" class="resource-name"/>
                </ui:VisualElement>
                <ui:VisualElement name="resource-item" class="resource-item">
                    <ui:VisualElement name="icon" class="resource-icon"/>
                    <ui:Label text="0" name="amount" class="resource-amount"/>
                    <ui:Label text="Scraponite" name="name" class="resource-name"/>
                </ui:VisualElement>
                <ui:VisualElement name="resource-item" class="resource-item">
                    <ui:VisualElement name="icon" class="resource-icon"/>
                    <ui:Label text="0" name="amount" class="resource-amount"/>
                    <ui:Label text="Pulsite" name="name" class="resource-name"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="action-buttons" style="flex-grow: 0; flex-direction: column; width: 25%; align-self: auto; align-content: auto; align-items: center; justify-content: space-between;">
            <ui:VisualElement name="upper-buttons" style="flex-grow: 1; flex-wrap: wrap; align-self: center; justify-content: flex-end; align-content: center; flex-direction: row; margin-right: 45px;">
                <ui:Button text="CRAFT" name="btn-craft" class="button"/>
                <ui:Button text="SWARM" name="btn-swarm" class="button"/>
            </ui:VisualElement>
            <ui:VisualElement name="bottom-buttons" style="flex-grow: 1; flex-wrap: wrap; align-self: center; justify-content: flex-end; align-content: center; flex-direction: column; margin-bottom: 40px;">
                <ui:Button text="CHOOSE PATH" name="btn-choose-path" class="button" style="width: 380px; height: 130px; -unity-font-style: bold; font-size: 35px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="panel-layer" picking-mode="Ignore" style="position: absolute; width: 100%; height: 100%; display: none;">
            <ui:VisualElement name="left-panel" style="position: absolute; width: 50%; height: 100%; align-self: flex-start;"/>
            <ui:VisualElement name="right-panel" style="position: absolute; width: 50%; height: 100%; align-self: flex-end;"/>
        </ui:VisualElement>
        <ui:VisualElement name="event-pop-up-container" style="flex-grow: 0; position: absolute; align-self: center; width: 550px; height: 400px; align-content: auto; justify-content: center; align-items: auto;">
            <ui:VisualElement name="event-panel" style="flex-grow: 1; align-self: flex-start; align-content: center; flex-direction: column; justify-content: flex-end; align-items: center;">
                <ui:VisualElement name="background" style="flex-grow: 0; height: 200px; width: 350px; background-color: rgb(118, 105, 33); border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-top-width: 10px; border-right-width: 10px; border-bottom-width: 10px; border-left-width: 10px; border-left-color: rgb(61, 54, 17); border-right-color: rgb(61, 54, 17); border-top-color: rgb(61, 54, 17); border-bottom-color: rgb(61, 54, 17); align-content: center; align-self: center; justify-content: center; align-items: center;">
                    <ui:Button text="Button" name="btn-event-pop-up" style="background-color: rgba(188, 188, 188, 0); width: 350px; height: 200px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
                        <ui:Label text="????" name="header" style="align-self: center; align-content: center; align-items: center; font-size: 45px; -unity-text-align: upper-center; -unity-font-style: bold;"/>
                        <ui:VisualElement name="icon" style="flex-grow: 0; height: 80px; width: 80px; align-self: center; align-content: center; align-items: center; justify-content: center; background-color: rgb(0, 0, 0); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;"/>
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="event-layer" picking-mode="Ignore" style="flex-grow: 1; position: absolute; height: 100%; width: 100%; align-self: stretch; align-content: stretch; justify-content: space-evenly; align-items: stretch;"/>
        <ui:VisualElement name="tooltip-layer" picking-mode="Ignore" style="position: absolute; width: 1920px; height: 100%; display: flex; background-color: rgba(0, 0, 0, 0); align-self: auto; align-items: stretch; align-content: auto; justify-content: flex-start; flex-direction: row;"/>
    </ui:VisualElement>
</ui:UXML>

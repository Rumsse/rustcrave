VisualElement {
}

.unit-container {
    align-items: auto;
    align-self: center;
    justify-content: center;
    align-content: flex-start;
    width: 90px;
    height: 90px;
    margin-top: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    margin-left: 15px;
}

.craft-btn {
}

.standard-tab-robots {
    border-top-left-radius: 10%;
    border-top-right-radius: 10%;
    border-bottom-right-radius: 10%;
    border-bottom-left-radius: 10%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgb(92, 82, 26);
    margin-top: 20px;
    margin-right: 40px;
    margin-bottom: 20px;
    margin-left: 15px;
    aspect-ratio: 1;
    width: auto;
    height: auto;
    justify-content: center;
    align-self: center;
    align-content: center;
    flex-grow: 1;
    font-size: 40px;
    align-items: stretch;
}

.standard-tab-gadgets {
    border-top-left-radius: 10%;
    border-top-right-radius: 10%;
    border-bottom-right-radius: 10%;
    border-bottom-left-radius: 10%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgb(92, 82, 26);
    margin-top: 20px;
    margin-right: 15px;
    margin-bottom: 20px;
    margin-left: 40px;
    aspect-ratio: 1;
    width: auto;
    height: auto;
    justify-content: center;
    align-self: center;
    align-content: center;
    flex-grow: 1;
    font-size: 40px;
    align-items: stretch;
}

.standard-btn-craft-gadget {
    flex-shrink: 1;
    width: 90px;
    height: 90px;
    background-color: rgb(0, 0, 0);
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 20px;
    color: rgb(255, 244, 232);
}

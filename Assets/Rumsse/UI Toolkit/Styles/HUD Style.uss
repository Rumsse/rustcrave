.resource-icon-spark {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Dorian/Sprites/Ore/Iskryt.png?fileID=21300000&guid=1009f3db327645b4498e2a07910a4a62&type=3#Iskryt");

.resource-item {
    flex-direction: row;
    align-content: center;
    background-color: rgb(118, 105, 33);
    height: 35px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    margin-top: 6px;
    margin-right: 6px;
    margin-bottom: 6px;
    margin-left: 6px;
    width: 225px;
    align-self: center;
    align-items: center;
}


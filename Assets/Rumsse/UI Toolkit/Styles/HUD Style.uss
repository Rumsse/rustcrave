.resource-amount {
    -unity-font-style: bold;
    width: 25px;
}

.resource-name {
    width: 90px;
}

.button {
    margin-top: 25px;
    margin-right: 25px;
    margin-bottom: 20px;
    margin-left: 25px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    height: 70px;
    width: 290px;
    font-size: 27px;
    background-color: rgb(117, 105, 33);
    -unity-font-style: bold;
}






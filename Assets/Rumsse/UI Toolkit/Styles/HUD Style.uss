.resource-amount {
    -unity-font-style: bold;
    width: 25px;
}

.resource-name {
    width: 90px;
}

.button {
    margin-top: 25px;
    margin-right: 25px;
    margin-bottom: 20px;
    margin-left: 25px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    height: 70px;
    width: 290px;
    font-size: 27px;
    background-color: rgb(117, 105, 33);
    -unity-font-style: bold;
}

.standard-event-popup-background {
    flex-grow: 0;
    height: 200px;
    width: 350px;
    background-color: rgb(118, 105, 33);
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-left-color: rgb(61, 54, 17);
    border-right-color: rgb(61, 54, 17);
    border-top-color: rgb(61, 54, 17);
    border-bottom-color: rgb(61, 54, 17);
    align-content: center;
    align-self: center;
    justify-content: center;
    align-items: center;
}

.standard-robot-craft-btn {
    flex-shrink: 1;
    width: 90px;
    height: 90px;
    background-color: rgb(0, 0, 0);
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 20px;
    color: rgb(255, 244, 232);
}

.QM-btn {
    justify-content: flex-end;
    align-self: center;
    align-items: stretch;
    align-content: center;
    background-color: rgb(92, 82, 26);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    width: 40%;
    height: 20%;
    color: rgb(27, 27, 27);
    font-size: 27px;
}

.unit-image {
    width: 150px;
    height: 150px;
    align-self: center;
    background-color: rgb(61, 54, 17);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-image: none;
    border-left-color: rgb(61, 54, 17);
    border-right-color: rgb(61, 54, 17);
    border-top-color: rgb(61, 54, 17);
    border-bottom-color: rgb(61, 54, 17);
}

.standard-gadget-slot-0 {
    width: 100px;
    height: 100px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    background-color: rgb(117, 105, 33);
    border-left-color: rgb(51, 46, 21);
    border-right-color: rgb(51, 46, 21);
    border-top-color: rgb(51, 46, 21);
    border-bottom-color: rgb(51, 46, 21);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

.custom-robot-dropdown {
    width: 550px;
    height: 70px;
    align-self: flex-start;
    align-content: center;
    align-items: center;
    left: 65px;
    font-size: 20px;
    border-top-left-radius: 27px;
    border-top-right-radius: 21px;
    border-bottom-right-radius: 21px;
    border-bottom-left-radius: 33px;
    margin-bottom: 2px;
    bottom: 0;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    background-color: rgba(255, 255, 255, 0);
    background-image: none;
    color: rgb(255, 244, 230);
}

.custom-robot-dropdown > .unity-base-field__label {
    color: rgb(255, 244, 230) !important;
}

.custom-robot-dropdown.unity-base-field:focus > .unity-base-field__label {
    color: rgb(255, 244, 230) !important;
}

.custom-robot-dropdown .unity-base-popup-field__input {
    background-image: url("project://database/Assets/Graphics%202D/UI%20tunnel/Ramka.PNG?fileID=21300000&guid=98951a3c692ba0847acbb39c08faa051&type=3#Ramka") !important;
    background-color: transparent !important;
    border-width: 0 !important;
    border-radius: 5px !important;
}

.custom-robot-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(156, 142, 107) !important;
}

.custom-robot-dropdown .unity-base-popup-field__text {
    color: rgb(220, 220, 220) !important;
    -unity-font-style: bold !important;
}

.unity-base-dropdown__container-outer {
    background-image: url("project://database/Assets/Graphics%202D/Swarm%20Icons/tlo.png?fileID=21300000&guid=95f5196b6ecec3d4bb87c7517e20753a&type=3#tlo") !important;
    background-color: transparent !important;
    border-color: rgb(156, 142, 107) !important;
    border-width: 1px !important;
    border-radius: 5px !important;
}

.unity-base-dropdown__container-inner,
.unity-base-dropdown .unity-scroll-view,
.unity-base-dropdown .unity-scroll-view__content-container {
    background-color: transparent !important;
}

.unity-base-dropdown__item {
    background-color: transparent !important;
    border-width: 0 !important;
    color: rgb(210, 210, 210) !important;
}

.unity-base-dropdown__item:checked,
.unity-base-dropdown__item:active {
    background-color: transparent !important;
}

.unity-base-dropdown__item:checked Label,
.unity-base-dropdown__item:active Label {
    color: rgb(210, 210, 210) !important;
}

.unity-base-dropdown__item:hover:enabled {
    background-color: rgba(250, 244, 230, 0.1) !important;
}

.unity-base-dropdown__item:hover:enabled Label {
    color: black !important;
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: rgb(156, 142, 107) !important;
}






.unity-scroller--vertical {
    width: 12px !important;
    min-width: 12px !important;
    background-color: transparent !important;
    position: absolute !important;
    right: -20px !important;
    height: 100% !important;
}

.unity-scroller--vertical .unity-scroller__low-button,
.unity-scroller--vertical .unity-scroller__high-button {
    display: none !important;
}

.unity-scroller--vertical .unity-base-slider {
    margin: 0 !important;
}

.unity-scroller--vertical .unity-base-slider__tracker,
.unity-scroller--vertical .unity-base-slider:hover .unity-base-slider__tracker,
.unity-scroller--vertical .unity-base-slider:active .unity-base-slider__tracker,
.unity-scroller--vertical .unity-base-slider:focus .unity-base-slider__tracker {
    background-color: transparent !important;
    background-image: none !important;
    border-width: 0 !important;
}

.unity-scroller--vertical .unity-base-slider__dragger,
.unity-scroller--vertical .unity-base-slider:hover .unity-base-slider__dragger,
.unity-scroller--vertical .unity-base-slider:active .unity-base-slider__dragger,
.unity-scroller--vertical .unity-base-slider:focus .unity-base-slider__dragger,
.unity-base-slider__dragger:hover,
.unity-base-slider__dragger:active {
    background-color: rgb(138, 128, 92) !important;
    background-image: none !important;
    border-width: 0 !important;
    border-radius: 6px !important;
    width: 7px !important;
    min-width: 7px !important;
    left: 4px !important;
    margin: 0 !important;
}
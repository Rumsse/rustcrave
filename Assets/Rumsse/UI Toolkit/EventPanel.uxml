<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="panel" style="align-self: auto; align-content: auto; flex-grow: 1; flex-shrink: 1;">
        <ui:VisualElement name="background" style="flex-grow: 0; background-color: rgb(88, 79, 25); width: 80%; height: 80%; justify-content: space-evenly; align-self: center; align-content: stretch; align-items: stretch; top: 100px; border-top-left-radius: 80px; border-top-right-radius: 80px; border-bottom-right-radius: 80px; border-bottom-left-radius: 80px; flex-direction: row; flex-shrink: 0;">
            <ui:VisualElement name="left-container" style="flex-grow: 1; align-content: center; align-items: stretch; justify-content: space-evenly; align-self: stretch;">
                <ui:VisualElement name="icon" style="flex-grow: 0; align-self: center; align-content: center; align-items: center; justify-content: flex-end; width: 500px; height: 650px; left: 20px; background-color: rgb(0, 0, 0); border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="right-container" style="flex-grow: 1;">
                <ui:Label text="EVENT TITLE" name="event-title" style="align-self: center; align-content: center; justify-content: center; align-items: center; font-size: 80px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; width: 900px; height: 215px;"/>
                <ui:Label text="event event event. Magic has happend. What do you do?" name="event-description" style="align-self: center; align-content: center; justify-content: center; align-items: center; font-size: 30px; -unity-font-style: normal; -unity-text-align: upper-center; white-space: normal; width: 900px; height: 215px;"/>
                <ui:DropdownField label="Who should take action? " name="robot-dropdown" style="width: 550px; height: 40px; align-self: flex-start; align-content: center; align-items: center; left: 65px; font-size: 20px; border-top-left-radius: 27px; border-top-right-radius: 21px; border-bottom-right-radius: 21px; border-bottom-left-radius: 33px; -unity-background-image-tint-color: rgba(255, 255, 255, 0); background-color: rgba(0, 0, 0, 0); margin-bottom: 15px;"/>
                <ui:VisualElement name="event-options" style="flex-grow: 1; margin-left: 50px; align-self: auto; align-content: flex-start; justify-content: flex-start;">
                    <ui:Button text="Button" name="option-1" style="align-items: center; align-self: flex-start; align-content: center; width: 550px; background-color: rgb(74, 63, 1); color: rgb(209, 208, 204); font-size: 25px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; border-left-color: rgb(55, 47, 0); border-right-color: rgb(55, 47, 0); border-top-color: rgb(55, 47, 0); border-bottom-color: rgb(55, 47, 0); margin-top: 20px; margin-right: 20px; margin-bottom: 20px; margin-left: 20px; -unity-text-align: middle-left; justify-content: flex-start;"/>
                    <ui:Button text="Button" name="option-2" style="align-items: center; align-self: flex-start; align-content: center; width: 550px; background-color: rgb(74, 63, 1); color: rgb(209, 208, 204); font-size: 25px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; border-left-color: rgb(55, 47, 0); border-right-color: rgb(55, 47, 0); border-top-color: rgb(55, 47, 0); border-bottom-color: rgb(55, 47, 0); margin-top: 20px; margin-right: 20px; margin-bottom: 20px; margin-left: 20px; -unity-text-align: middle-left;"/>
                    <ui:Button text="Button" name="option-3" style="align-items: center; align-self: flex-start; align-content: center; width: 550px; background-color: rgb(74, 63, 1); color: rgb(209, 208, 204); font-size: 25px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; border-left-color: rgb(55, 47, 0); border-right-color: rgb(55, 47, 0); border-top-color: rgb(55, 47, 0); border-bottom-color: rgb(55, 47, 0); margin-top: 20px; margin-right: 20px; margin-bottom: 20px; margin-left: 20px; -unity-text-align: middle-left;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="X" name="btn-close" style="border-top-left-radius: 127px; border-top-right-radius: 127px; border-bottom-right-radius: 127px; border-bottom-left-radius: 127px; border-left-color: rgb(72, 72, 72); border-right-color: rgb(72, 72, 72); border-top-color: rgb(72, 72, 72); border-bottom-color: rgb(72, 72, 72); background-color: rgb(27, 27, 27); color: rgb(255, 244, 232); width: 40px; height: 40px; margin-top: 23px; margin-right: 23px; margin-bottom: 23px; margin-left: 23px; align-self: flex-start; position: absolute; top: 122px; left: 1606px; align-items: auto; align-content: center; justify-content: flex-start;"/>
    </ui:VisualElement>
</ui:UXML>

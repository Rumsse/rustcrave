<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Rumsse/UI%20Toolkit/Styles/HUD%20Style.uss?fileID=7433441132597879392&amp;guid=7b47a7b00a228194890309076bd0a8b2&amp;type=3#HUD Style"/>
    <ui:VisualElement name="unit-info-panel" picking-mode="Ignore" style="flex-grow: 1; background-color: rgb(74, 63, 1); border-top-left-radius: 0%; border-bottom-left-radius: 0%; align-content: center; align-items: stretch; background-image: none; width: 100%; height: 100%; border-top-right-radius: 7%; border-bottom-right-radius: 7%; flex-wrap: wrap; align-self: center; flex-direction: row; position: relative;">
        <ui:VisualElement name="swarm-panel" picking-mode="Ignore" style="flex-grow: 1; height: 100%; width: 85%; align-items: center; align-self: center; flex-direction: column; flex-wrap: nowrap;">
            <ui:VisualElement name="upper-section" picking-mode="Ignore" style="flex-grow: 0; width: 100%; height: 235px; flex-shrink: 0; align-self: center; align-content: center; align-items: center; justify-content: flex-start; margin-top: 55px; flex-direction: row; margin-bottom: 10px;">
                <ui:VisualElement name="unit-image" style="flex-grow: 0; width: 200px; height: 90%; flex-shrink: 1; flex-wrap: nowrap; background-image: url(&quot;project://database/Assets/Dorian/Sprites/RobotIconExample.png?fileID=2800000&amp;guid=709cbec79718509458cacc4f211c72f6&amp;type=3#RobotIconExample&quot;); margin-left: 8%; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; margin-bottom: 4%;"/>
                <ui:VisualElement name="space" style="flex-grow: 0; width: 45px; height: 100%;"/>
                <ui:VisualElement name="texts" style="flex-grow: 0; height: 280px; align-self: flex-start; justify-content: flex-start; align-items: stretch; flex-wrap: wrap; width: 600px; bottom: 25px;">
                    <ui:Label text="UNIT" name="unit-name" style="align-self: flex-start; align-content: center; align-items: stretch; justify-content: space-evenly; font-size: 50px; -unity-text-align: upper-left; -unity-font-style: bold; width: 450px; flex-direction: column; flex-wrap: wrap; height: 60px;"/>
                    <ui:Label text="unit description" name="unit-description" style="font-size: 20px; white-space: normal; flex-shrink: 0; flex-wrap: wrap; height: 135px; width: 595px; color: rgb(0, 0, 0);"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="middle-upper-section" style="flex-grow: 0; width: 100%; height: 209px; flex-shrink: 0; flex-direction: row; align-items: stretch; align-self: auto; align-content: center; justify-content: flex-start;">
                <ui:VisualElement name="swarm-slots-container" style="flex-grow: 1; align-self: flex-start; align-content: center; justify-content: center; align-items: stretch; margin-top: 35px; margin-right: 30px; margin-bottom: 0; margin-left: 45px; flex-direction: column; flex-wrap: wrap; height: 140px;">
                    <ui:VisualElement name="health" style="flex-grow: 1; font-size: 45px; flex-direction: row; width: 420px; height: 20px;">
                        <ui:Label text="Health: 40/40" name="hp-label" style="font-size: 40px; margin-bottom: 10px; flex-shrink: 1; flex-direction: row; flex-grow: 1; -unity-text-align: middle-left; width: 370px;"/>
                        <ui:Button text="Repair" name="btn-repair" style="justify-content: space-evenly; align-self: center; align-items: stretch; align-content: center; display: flex; width: 120px; height: 40px; font-size: 20px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; background-color: rgb(116, 105, 33); border-left-color: rgb(75, 64, 57); border-right-color: rgb(75, 64, 57); border-top-color: rgb(75, 64, 57); border-bottom-color: rgb(75, 64, 57);"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="energy" style="flex-grow: 1; font-size: 45px; flex-direction: row; width: 420px; height: 20px;">
                        <ui:Label text="Energy: 100%" name="energy-label" style="font-size: 40px; margin-bottom: 10px; flex-shrink: 1; flex-direction: row; flex-grow: 1; -unity-text-align: middle-left; width: 370px;"/>
                        <ui:Button text="Charge" name="btn-charge" style="justify-content: space-evenly; align-self: center; align-items: stretch; align-content: center; display: flex; width: 120px; height: 40px; font-size: 20px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; background-color: rgb(116, 105, 33); border-left-color: rgb(75, 64, 57); border-right-color: rgb(75, 64, 57); border-top-color: rgb(75, 64, 57); border-bottom-color: rgb(75, 64, 57);"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="gadgets" style="flex-grow: 1; align-self: flex-start; align-content: flex-start; justify-content: flex-end; align-items: stretch; margin-top: 0; margin-right: 30px; margin-bottom: 0; margin-left: 55px; flex-direction: column; flex-wrap: wrap;">
                    <ui:Label text="Installed Gadgets" name="header" style="font-size: 45px; flex-shrink: 1; -unity-text-align: upper-center;"/>
                    <ui:VisualElement name="gadgets-slots-container" style="flex-grow: 1; flex-direction: row; align-self: stretch; justify-content: center; align-items: stretch; width: 415px; -unity-text-align: upper-left;">
                        <ui:Button text="" name="gadget-slot-0" style="width: 100px; height: 100px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; background-color: rgb(117, 105, 33); border-left-color: rgb(51, 46, 21); border-right-color: rgb(51, 46, 21); border-top-color: rgb(51, 46, 21); border-bottom-color: rgb(51, 46, 21); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
                        <ui:Button text="" name="gadget-slot-1" style="width: 100px; height: 100px; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; background-color: rgb(117, 105, 33); border-left-color: rgb(51, 46, 21); border-right-color: rgb(51, 46, 21); border-top-color: rgb(51, 46, 21); border-bottom-color: rgb(51, 46, 21); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="middle-bottom-section" style="flex-grow: 1; flex-direction: row; flex-wrap: nowrap; align-content: stretch; align-items: stretch; justify-content: flex-start; align-self: stretch;">
                <ui:VisualElement name="ability-container" style="flex-grow: 0; flex-shrink: 0; justify-content: space-evenly; align-self: stretch; align-content: stretch; width: 593px;">
                    <ui:Label text="Abilities:" name="header" style="align-self: flex-start; font-size: 40px; margin-left: 45px; -unity-font-style: bold;"/>
                    <ui:Label name="ability-description" style="align-self: stretch; font-size: 25px; margin-left: 45px; flex-grow: 1; flex-shrink: 1; width: 545px; height: 35%; white-space: normal; justify-content: space-evenly; align-content: stretch; color: rgb(0, 0, 0);"/>
                </ui:VisualElement>
                <ui:VisualElement name="stats-container" style="flex-grow: 0; flex-shrink: 0; justify-content: space-evenly; align-self: stretch; align-content: stretch; width: 300px; align-items: stretch; margin-left: 50px;">
                    <ui:Label text="Stats:" name="header" style="align-self: flex-start; font-size: 40px; margin-left: 4px; -unity-font-style: bold;"/>
                    <ui:Label name="stats-stats" style="align-self: flex-start; font-size: 25px; margin-left: 4px; flex-grow: 1; flex-shrink: 1; width: 276px; height: 35%; white-space: normal; justify-content: flex-start; align-content: center; align-items: stretch;">
                        <ui:Label text="HP:" name="hp-stat"/>
                        <ui:Label text="EN:" name="en-stat"/>
                        <ui:Label text="ATK:" name="atk-stat"/>
                        <ui:Label text="DIG:" name="dig-stat"/>
                        <ui:Label text="SPD:" name="spd-stat"/>
                        <ui:Label text="CAP:" name="cap-stat"/>
                    </ui:Label>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="bottom-section" style="flex-grow: 0; width: 100%; height: 125px; flex-shrink: 0; align-content: stretch; justify-content: center; align-items: auto; align-self: stretch; flex-direction: column;">
                <ui:VisualElement name="resource-bar" style="flex-grow: 1; justify-content: flex-end; align-self: center; align-content: center; align-items: center; width: 100%; height: auto; flex-shrink: 1; margin-bottom: 25px;">
                    <ui:Label text="You have:" name="you-have" style="align-self: center; align-content: flex-start; align-items: center; justify-content: center; -unity-font-style: bold; font-size: 20px; bottom: 7px; margin-bottom: 15px;"/>
                    <ui:VisualElement name="resources" style="flex-grow: 0; flex-direction: row; align-content: center; height: 25%; flex-wrap: nowrap; align-self: center; justify-content: center; align-items: center; width: 100%; left: auto;">
                        <ui:VisualElement name="resource-sparklite" class="resource-item" style="width: 200px; flex-direction: row; flex-wrap: nowrap; align-content: center; align-self: center; justify-content: center;">
                            <ui:VisualElement name="icon" class="resource-icon resource-icon-spark"/>
                            <ui:Label text="0" name="amount" class="resource-amount">
                                <Bindings>
                                    <ui:DataBinding property="text" data-source-path="Sparklite" binding-mode="ToTarget"/>
                                </Bindings>
                            </ui:Label>
                            <ui:Label text="Sparklite" name="name" class="resource-name"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="resource-scraponite" class="resource-item" style="width: 200px; flex-direction: row; justify-content: center; align-self: center; align-content: center;">
                            <ui:VisualElement name="icon" class="resource-icon resource-icon-scraponite"/>
                            <ui:Label text="0" name="amount" class="resource-amount">
                                <Bindings>
                                    <ui:DataBinding property="text" data-source-path="Scraponite" binding-mode="ToTarget"/>
                                </Bindings>
                            </ui:Label>
                            <ui:Label text="Scraponite" name="name" class="resource-name"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="resource-pulsite" class="resource-item" style="flex-direction: row; width: 200px; justify-content: center; align-self: center; align-content: center;">
                            <ui:VisualElement name="icon" class="resource-icon resource-icon-pulsite"/>
                            <ui:Label text="0" name="amount" class="resource-amount">
                                <Bindings>
                                    <ui:DataBinding property="text" data-source-path="Pulsite" binding-mode="ToTarget"/>
                                </Bindings>
                            </ui:Label>
                            <ui:Label text="Pulsite" name="name" class="resource-name"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="gadgets-popup" style="flex-grow: 1; position: absolute; width: 135px; height: 206px; background-color: rgb(116, 105, 33); border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; top: 312px; left: 478px; display: none;">
            <ui:Button text="X" name="btn-close-popup" style="border-top-left-radius: 127px; border-top-right-radius: 127px; border-bottom-right-radius: 127px; border-bottom-left-radius: 127px; border-left-color: rgb(72, 72, 72); border-right-color: rgb(72, 72, 72); border-top-color: rgb(72, 72, 72); border-bottom-color: rgb(72, 72, 72); background-color: rgb(27, 27, 27); color: rgb(255, 244, 232); width: 40px; height: 40px; margin-top: 23px; margin-right: 23px; margin-bottom: 23px; margin-left: 23px; align-self: flex-start; position: absolute; top: -41px; left: -41px; align-items: auto; align-content: center; justify-content: flex-start;"/>
            <ui:ScrollView name="gadgets-list-container" style="flex-wrap: wrap; flex-direction: column; display: flex; height: 204px; flex-grow: 1; align-items: center; justify-content: flex-end; align-self: auto; align-content: center;"/>
        </ui:VisualElement>
        <ui:Button text="X" name="btn-close" style="border-top-left-radius: 127px; border-top-right-radius: 127px; border-bottom-right-radius: 127px; border-bottom-left-radius: 127px; border-left-color: rgb(72, 72, 72); border-right-color: rgb(72, 72, 72); border-top-color: rgb(72, 72, 72); border-bottom-color: rgb(72, 72, 72); background-color: rgb(27, 27, 27); color: rgb(255, 244, 232); width: 40px; height: 40px; margin-top: 23px; margin-right: 23px; margin-bottom: 23px; margin-left: 23px; align-self: flex-start; position: absolute; top: 10px; left: 846px; align-items: auto; align-content: center; justify-content: flex-start;"/>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="node-tooltip" style="flex-grow: 1; flex-direction: column; flex-wrap: wrap; align-self: center; align-content: center; align-items: center; justify-content: flex-start; background-color: rgb(253, 243, 230); flex-shrink: 1; flex-basis: 0%; width: 280px; height: 170px; border-top-left-radius: 17px; border-top-right-radius: 17px; border-bottom-right-radius: 17px; border-bottom-left-radius: 17px; position: absolute;">
        <ui:Label text="UNKNOWN" name="tooltip-title" style="align-self: center; align-items: center; justify-content: center; align-content: center; font-size: 25px; -unity-text-align: middle-center; -unity-font-style: bold; flex-grow: 0; flex-shrink: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 17%; margin-right: 10%; margin-bottom: 10%; margin-left: 10%; width: 222px; white-space: normal;"/>
        <ui:VisualElement name="tooltip-body" style="flex-grow: 0; align-content: center; align-self: center; align-items: center; margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%;">
            <ui:Label text="PRESS RMB TO SCAN" name="tooltip-action" style="font-size: 12px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            <ui:Label text="Costs 1 Pulsite" name="tooltip-cost" style="font-size: 10px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

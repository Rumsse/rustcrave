<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="container" picking-mode="Ignore" style="flex-grow: 1; flex-wrap: nowrap; align-content: center; align-self: center; justify-content: center; align-items: center; position: absolute;">
        <ui:VisualElement name="gadget-popup-icon" style="flex-grow: 0; background-color: rgb(120, 101, 43); width: 280px; height: 280px; align-self: center; align-content: center; align-items: center; justify-content: center;"/>
        <ui:Label text="Label" name="gadget-popup-text" style="align-self: center; align-content: center; align-items: center; justify-content: center; -unity-text-align: middle-center; white-space: normal; -unity-font-style: bold; font-size: 18px;"/>
    </ui:VisualElement>
</ui:UXML>

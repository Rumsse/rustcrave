<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="unit-container" class="unit-container" style="flex-grow: 0; width: 150px; height: 215px; align-items: flex-start; align-self: center; align-content: center; justify-content: center; margin-top: 15px; margin-right: 15px; margin-bottom: 15px; margin-left: 15px; flex-direction: column;">
        <ui:Button text="" name="unit-image" style="width: 150px; height: 150px; align-self: center; background-color: rgb(61, 54, 17); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; background-image: none; border-left-color: rgb(61, 54, 17); border-right-color: rgb(61, 54, 17); border-top-color: rgb(61, 54, 17); border-bottom-color: rgb(61, 54, 17);"/>
        <ui:Label text="" name="hp-label" class="textcolor" style="-unity-font-style: bold;"/>
        <ui:Label text="" name="energy-label" class="textcolor" style="-unity-font-style: bold;"/>
    </ui:VisualElement>
</ui:UXML>

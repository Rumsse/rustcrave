<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Rumsse/UI%20Toolkit/Styles/HUD%20Style.uss?fileID=7433441132597879392&amp;guid=7b47a7b00a228194890309076bd0a8b2&amp;type=3#HUD Style"/>
    <Style src="project://database/Assets/Rumsse/UI%20Toolkit/Styles/Tutorial%20Styles.uss?fileID=7433441132597879392&amp;guid=0edd93bd5a288e949b4f97a3e8f650e9&amp;type=3#Tutorial Styles"/>
    <Style src="project://database/Assets/Rumsse/UI%20Toolkit/Styles/QuickManagementActive.uss?fileID=7433441132597879392&amp;guid=437658f1548926b42abbdb19d7fc5734&amp;type=3#QuickManagementActive"/>
    <ui:VisualElement name="Root" picking-mode="Ignore" style="flex-grow: 1; background-color: rgb(74, 63, 1); border-top-left-radius: 0%; border-bottom-left-radius: 0%; align-content: center; align-items: stretch; background-image: none; width: 100%; height: 100%; border-top-right-radius: 7%; border-bottom-right-radius: 7%; flex-wrap: wrap; align-self: center; flex-direction: row;">
        <ui:VisualElement name="swarm-panel" picking-mode="Ignore" class="background" style="flex-grow: 1; height: 100%; width: 85%; align-items: center; align-self: center; flex-direction: column; flex-wrap: nowrap; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/Crafting/T%C5%82o_Crafting.PNG?fileID=2800000&amp;guid=78f004ca403aca44ea56fc1453454447&amp;type=3#T&#322;o_Crafting&quot;);">
            <ui:VisualElement name="upper-section" picking-mode="Ignore" style="flex-grow: 0; width: 100%; height: 20%; flex-shrink: 1; align-self: center; align-content: center; align-items: center; justify-content: flex-start; margin-top: 70px;">
                <ui:Label text="SWARM" name="header" class="quick-management-active original-textcolor textcolor" style="align-self: center; align-content: center; align-items: center; justify-content: center; font-size: 70px; -unity-text-align: middle-center; -unity-font-style: bold; color: rgb(132, 115, 88);"/>
                <ui:Label text="" name="subtitle-label" class="quick-management-active textcolor" style="font-size: 25px; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:VisualElement name="middle-section" style="flex-grow: 1; width: 100%; height: 80%; flex-shrink: 1; flex-direction: column;">
                <ui:VisualElement name="swarm-slots-container" style="flex-grow: 1; align-self: stretch; align-content: stretch; justify-content: space-evenly; align-items: stretch; margin-top: 50px; margin-right: 50px; margin-bottom: 50px; margin-left: 50px; flex-direction: row; flex-wrap: wrap;"/>
            </ui:VisualElement>
            <ui:VisualElement name="bottom-section" style="flex-grow: 1; width: 100%; height: 40%; flex-shrink: 1; align-content: stretch; justify-content: center; align-items: auto; align-self: stretch; flex-direction: column;">
                <ui:Button text="Quick Management" name="btn-quick-management" class="standard-btn-q-management quickmanagementbtn"/>
                <ui:Label text="LMB to repair | RLB to charge " name="hint" class="textcolor" style="align-self: center;"/>
                <ui:VisualElement name="resource-bar" style="flex-grow: 1; justify-content: center; align-self: center; align-content: center; align-items: center; width: 100%; height: 25%;">
                    <ui:Label text="You have:" name="you-have" class="quick-management-active original-textcolor textcolor" style="align-self: center; align-content: flex-start; align-items: center; justify-content: center; -unity-font-style: bold; font-size: 20px; color: rgb(134, 116, 88);"/>
                    <ui:VisualElement name="resources" style="flex-grow: 0; flex-direction: row; align-content: center; height: 25%; flex-wrap: nowrap; align-self: center; justify-content: center; align-items: center; width: 100%; left: auto;">
                        <ui:VisualElement name="resource-sparklite" class="resource-item" style="width: 200px; flex-direction: row; flex-wrap: nowrap; align-content: center; align-self: center; justify-content: center;">
                            <ui:VisualElement name="icon" class="resource-icon resource-icon-spark"/>
                            <ui:Label text="0" name="amount" class="resource-amount">
                                <Bindings>
                                    <ui:DataBinding property="text" data-source-path="Sparklite" binding-mode="ToTarget"/>
                                </Bindings>
                            </ui:Label>
                            <ui:Label text="Sparklite" name="name" class="resource-name"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="resource-scraponite" class="resource-item" style="width: 200px; flex-direction: row; justify-content: center; align-self: center; align-content: center;">
                            <ui:VisualElement name="icon" class="resource-icon resource-icon-scraponite"/>
                            <ui:Label text="0" name="amount" class="resource-amount">
                                <Bindings>
                                    <ui:DataBinding property="text" data-source-path="Scraponite" binding-mode="ToTarget"/>
                                </Bindings>
                            </ui:Label>
                            <ui:Label text="Scraponite" name="name" class="resource-name"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="resource-pulsite" class="resource-item" style="flex-direction: row; width: 200px; justify-content: center; align-self: center; align-content: center;">
                            <ui:VisualElement name="icon" class="resource-icon resource-icon-pulsite"/>
                            <ui:Label text="0" name="amount" class="resource-amount">
                                <Bindings>
                                    <ui:DataBinding property="text" data-source-path="Pulsite" binding-mode="ToTarget"/>
                                </Bindings>
                            </ui:Label>
                            <ui:Label text="Pulsite" name="name" class="resource-name"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="unit-info-container" picking-mode="Ignore" style="flex-grow: 1; position: absolute; width: 100%; height: 100%;"/>
        <ui:Button text="" name="btn-close" style="border-top-left-radius: 127px; border-top-right-radius: 127px; border-bottom-right-radius: 127px; border-bottom-left-radius: 127px; border-left-color: rgba(72, 72, 72, 0); border-right-color: rgba(72, 72, 72, 0); border-top-color: rgba(72, 72, 72, 0); border-bottom-color: rgba(72, 72, 72, 0); background-color: rgb(27, 27, 27); color: rgb(255, 244, 232); width: 40px; height: 40px; margin-top: 23px; margin-right: 23px; margin-bottom: 23px; margin-left: 23px; align-self: flex-start; position: absolute; top: 10px; left: 846px; align-items: auto; align-content: center; justify-content: flex-start; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/General/X.PNG?fileID=2800000&amp;guid=cb89d58f426c8b549a79aa764ec1ad30&amp;type=3#X&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Rumsse/UI%20Toolkit/Styles/HUD%20Style.uss?fileID=7433441132597879392&amp;guid=7b47a7b00a228194890309076bd0a8b2&amp;type=3#HUD Style"/>
    <Style src="project://database/Assets/Rumsse/UI%20Toolkit/Styles/Tutorial%20Styles.uss?fileID=7433441132597879392&amp;guid=0edd93bd5a288e949b4f97a3e8f650e9&amp;type=3#Tutorial Styles"/>
    <Style src="project://database/Assets/Rumsse/UI%20Toolkit/Styles/UnityStandardContainers.uss?fileID=7433441132597879392&amp;guid=3b5b7da4ffb0f804fa514c02bf0501e2&amp;type=3#UnityStandardContainers"/>
    <ui:VisualElement name="unit-info-panel" picking-mode="Ignore" style="flex-grow: 1; background-color: rgb(74, 63, 1); border-top-left-radius: 0%; border-bottom-left-radius: 0%; align-content: center; align-items: stretch; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/Swarm/Informacje_T%C5%82o.PNG?fileID=2800000&amp;guid=0a789f61407eb8e46b28f0a2bb1a9031&amp;type=3#Informacje_T&#322;o&quot;); width: 100%; height: 100%; border-top-right-radius: 0%; border-bottom-right-radius: 0%; flex-wrap: wrap; align-self: center; flex-direction: row; position: relative;">
        <ui:VisualElement name="swarm-panel" picking-mode="Ignore" style="flex-grow: 1; height: 100%; width: 85%; align-items: center; align-self: center; flex-direction: column; flex-wrap: nowrap;">
            <ui:VisualElement name="upper-section" picking-mode="Ignore" style="flex-grow: 0; width: 100%; height: 244px; flex-shrink: 0; align-self: center; align-content: center; align-items: center; justify-content: flex-start; margin-top: 55px; flex-direction: row; margin-bottom: 10px;">
                <ui:VisualElement name="image-background" style="flex-grow: 1; position: absolute; width: 208px; height: 212px; top: 6px; left: 70px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; background-image: url(&quot;project://database/Assets/Graphics%202D/Swarm%20Icons/tlo.png?fileID=2800000&amp;guid=95f5196b6ecec3d4bb87c7517e20753a&amp;type=3#tlo&quot;);"/>
                <ui:VisualElement name="unit-image" style="flex-grow: 0; width: 205px; height: 205px; flex-shrink: 1; flex-wrap: nowrap; background-image: url(&quot;project://database/Assets/Dorian/Sprites/RobotIconExample.png?fileID=2800000&amp;guid=709cbec79718509458cacc4f211c72f6&amp;type=3#RobotIconExample&quot;); margin-left: 70px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; margin-bottom: 20px; display: flex;"/>
                <ui:VisualElement name="space" style="flex-grow: 0; width: 45px; height: 100%;"/>
                <ui:VisualElement name="texts" style="flex-grow: 0; height: 220px; align-self: center; justify-content: flex-start; align-items: flex-start; flex-wrap: wrap; width: 600px; bottom: 25px; margin-top: 35px; align-content: center;">
                    <ui:Label text="UNIT" name="unit-name" style="align-self: flex-start; align-content: center; align-items: stretch; justify-content: space-evenly; font-size: 35px; -unity-text-align: middle-left; -unity-font-style: bold; width: 450px; flex-direction: column; flex-wrap: wrap; height: 50px; color: rgb(183, 174, 160); margin-top: 5px; padding-top: 10px;"/>
                    <ui:Label text="unit description" name="unit-description" style="font-size: 17px; white-space: normal; flex-shrink: 0; flex-wrap: wrap; height: 128px; width: 527px; color: rgb(183, 174, 160); -unity-paragraph-spacing: 15px; padding-right: 25px; margin-top: 2px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="middle-upper-section" style="flex-grow: 0; width: 100%; height: 259px; flex-shrink: 0; flex-direction: row; align-items: center; align-self: center; align-content: center; justify-content: center;">
                <ui:VisualElement name="swarm-slots-container" style="flex-grow: 0; align-self: center; align-content: center; justify-content: flex-end; align-items: center; flex-direction: column; flex-wrap: wrap; height: 70%; flex-shrink: 0; width: 50%; margin-bottom: 10px;">
                    <ui:VisualElement name="health" style="flex-grow: 1; font-size: 45px; flex-direction: row; width: 360px; height: 0; align-items: center; justify-content: flex-start; align-self: center; align-content: center; margin-top: 15px;">
                        <ui:Label text="Health: 40/40" name="hp-label" style="font-size: 28px; margin-bottom: 10px; flex-shrink: 1; flex-direction: row; flex-grow: 0; -unity-text-align: middle-left; width: 210px; color: rgb(183, 174, 160); margin-left: 15px;"/>
                        <ui:Button text="Repair" name="btn-repair" class="btn-quick-repair-charge"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="energy" style="flex-grow: 1; font-size: 45px; flex-direction: row; width: 360px; height: 0; align-self: center; align-content: center; align-items: center; margin-bottom: 15px;">
                        <ui:Label text="Energy: 100%" name="energy-label" style="font-size: 28px; margin-bottom: 10px; flex-shrink: 1; flex-direction: row; flex-grow: 0; -unity-text-align: middle-left; width: 210px; color: rgb(183, 174, 160); margin-left: 14px;"/>
                        <ui:Button text="Charge" name="btn-charge" class="btn-quick-repair-charge" style="display: flex; font-size: 20px; color: rgb(17, 17, 17);"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="gadgets" style="flex-grow: 0; align-self: center; align-content: center; justify-content: flex-end; align-items: center; flex-direction: column; flex-wrap: wrap; height: 70%; width: 50%; flex-shrink: 0; margin-bottom: 10px; padding-right: 30px;">
                    <ui:Label text="Installed Gadgets" name="header" style="font-size: 25px; flex-shrink: 1; -unity-text-align: upper-center; color: rgb(183, 174, 160); padding-top: 10px;"/>
                    <ui:VisualElement name="gadgets-slots-container" style="flex-grow: 1; flex-direction: row; align-self: center; justify-content: center; align-items: center; width: 375px; -unity-text-align: upper-left; align-content: center; margin-bottom: 10px;">
                        <ui:VisualElement name="background-gadget-slot" class="background-gadget-slot">
                            <ui:Button text="" name="gadget-slot-0" class="standard-gadget-slot-0" style="margin-top: 5px; margin-bottom: 5px; align-self: center; align-content: center; align-items: center; width: 90px; height: 90px;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="background-gadget-slot" class="background-gadget-slot">
                            <ui:Button text="" name="gadget-slot-1" class="standard-gadget-slot-1" style="width: 90px; height: 90px; margin-top: 5px; margin-right: 10px; margin-bottom: 5px; margin-left: 10px; justify-content: center; align-self: center; align-content: center; align-items: center;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="middle-bottom-section" style="flex-grow: 1; flex-direction: row; flex-wrap: nowrap; align-content: stretch; align-items: stretch; justify-content: flex-start; align-self: stretch; margin-top: 25px;">
                <ui:VisualElement name="ability-container" style="flex-grow: 0; flex-shrink: 0; justify-content: flex-start; align-self: stretch; align-content: stretch; width: 475px; align-items: center;">
                    <ui:Label text="Abilities:" name="header" style="align-self: flex-start; font-size: 30px; margin-left: 95px; -unity-font-style: bold; color: rgb(183, 174, 160); margin-top: 20px;"/>
                    <ui:Label name="ability-description" text="" style="align-self: stretch; font-size: 18px; margin-left: 95px; flex-grow: 1; flex-shrink: 1; width: auto; height: 35%; white-space: normal; justify-content: space-evenly; align-content: stretch; color: rgb(183, 174, 160); padding-right: 1px; -unity-paragraph-spacing: 17px; margin-top: 12px; margin-right: 50px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="stats-container" style="flex-grow: 0; flex-shrink: 0; justify-content: flex-start; align-self: stretch; align-content: stretch; width: 300px; align-items: center; margin-left: 160px;">
                    <ui:Label text="Stats:" name="header" style="align-self: flex-start; font-size: 30px; margin-left: 6px; -unity-font-style: bold; color: rgb(183, 174, 160); margin-top: 20px;"/>
                    <ui:Label name="stats-stats" style="align-self: flex-start; font-size: 25px; margin-left: 4px; flex-grow: 0; flex-shrink: 1; width: 275px; height: 240px; white-space: normal; justify-content: space-between; align-content: center; align-items: stretch; margin-top: 12px;">
                        <ui:Label text="HP:" name="hp-stat" style="color: rgb(183, 174, 160); font-size: 23px;"/>
                        <ui:Label text="EN:" name="en-stat" style="color: rgb(183, 174, 160); font-size: 23px;"/>
                        <ui:Label text="ATK:" name="atk-stat" style="color: rgb(183, 174, 160); font-size: 23px;"/>
                        <ui:Label text="DIG:" name="dig-stat" style="color: rgb(183, 174, 160); font-size: 23px;"/>
                        <ui:Label text="SPD:" name="spd-stat" style="color: rgb(183, 174, 160); font-size: 23px;"/>
                        <ui:Label text="CAP:" name="cap-stat" style="color: rgb(183, 174, 160); font-size: 23px;"/>
                    </ui:Label>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="bottom-section" style="flex-grow: 0; width: 100%; height: 125px; flex-shrink: 0; align-content: stretch; justify-content: center; align-items: auto; align-self: stretch; flex-direction: column;">
                <ui:VisualElement name="resource-bar" style="flex-grow: 1; justify-content: flex-end; align-self: center; align-content: center; align-items: center; width: 100%; height: auto; flex-shrink: 1; margin-bottom: 25px;">
                    <ui:Label text="You have:" name="you-have" style="align-self: center; align-content: flex-start; align-items: center; justify-content: center; -unity-font-style: bold; font-size: 20px; bottom: 7px; margin-bottom: 5px; color: rgb(171, 151, 119);"/>
                    <ui:VisualElement name="resources" style="flex-grow: 0; flex-direction: row; align-content: center; height: 25%; flex-wrap: nowrap; align-self: center; justify-content: center; align-items: center; width: 100%; left: auto; margin-bottom: 20px;">
                        <ui:VisualElement name="resource-sparklite" class="resource-item" style="width: 200px; flex-direction: row; flex-wrap: nowrap; align-content: center; align-self: center; justify-content: center;">
                            <ui:VisualElement name="icon" class="resource-icon resource-icon-spark"/>
                            <ui:Label text="0" name="amount" class="resource-amount">
                                <Bindings>
                                    <ui:DataBinding property="text" data-source-path="Sparklite" binding-mode="ToTarget"/>
                                </Bindings>
                            </ui:Label>
                            <ui:Label text="Sparklite" name="name" class="resource-name"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="resource-scraponite" class="resource-item" style="width: 200px; flex-direction: row; justify-content: center; align-self: center; align-content: center;">
                            <ui:VisualElement name="icon" class="resource-icon resource-icon-scraponite"/>
                            <ui:Label text="0" name="amount" class="resource-amount">
                                <Bindings>
                                    <ui:DataBinding property="text" data-source-path="Scraponite" binding-mode="ToTarget"/>
                                </Bindings>
                            </ui:Label>
                            <ui:Label text="Scraponite" name="name" class="resource-name"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="resource-pulsite" class="resource-item" style="flex-direction: row; width: 200px; justify-content: center; align-self: center; align-content: center;">
                            <ui:VisualElement name="icon" class="resource-icon resource-icon-pulsite"/>
                            <ui:Label text="0" name="amount" class="resource-amount">
                                <Bindings>
                                    <ui:DataBinding property="text" data-source-path="Pulsite" binding-mode="ToTarget"/>
                                </Bindings>
                            </ui:Label>
                            <ui:Label text="Pulsite" name="name" class="resource-name"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="gadgets-popup" style="flex-grow: 1; position: absolute; width: 135px; height: 327px; background-color: rgba(116, 105, 33, 0); border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; top: 239px; left: 448px; display: none; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/Crafting/Rura_z_lewej%20(1).PNG?fileID=2800000&amp;guid=454746b71dc08504d89653f781d4393b&amp;type=3#Rura_z_lewej (1)&quot;); -unity-slice-type: sliced; -unity-slice-left: 114; -unity-slice-top: 114; -unity-slice-right: 114; -unity-slice-bottom: 114;">
            <ui:ScrollView name="gadgets-list-container" style="flex-wrap: wrap; flex-direction: column; display: flex; height: 204px; flex-grow: 1; align-items: center; justify-content: flex-end; align-self: auto; align-content: center;"/>
            <ui:Button text="" name="btn-close-popup" style="border-top-left-radius: 127px; border-top-right-radius: 127px; border-bottom-right-radius: 127px; border-bottom-left-radius: 127px; border-left-color: rgba(72, 72, 72, 0); border-right-color: rgba(72, 72, 72, 0); border-top-color: rgba(72, 72, 72, 0); border-bottom-color: rgba(72, 72, 72, 0); background-color: rgba(27, 27, 27, 0); color: rgb(255, 244, 232); width: 20px; height: 22px; margin-top: 23px; margin-right: 23px; margin-bottom: 23px; margin-left: 23px; align-self: flex-start; position: absolute; top: -21px; left: -21px; align-items: auto; align-content: center; justify-content: flex-start; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/General/X.PNG?fileID=2800000&amp;guid=cb89d58f426c8b549a79aa764ec1ad30&amp;type=3#X&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
        </ui:VisualElement>
        <ui:Button text="" name="btn-close" class="btn-back" style="position: absolute; top: 10px; left: 846px;"/>
        <ui:VisualElement name="tooltip-layer" picking-mode="Ignore" style="position: absolute; width: 960px; height: 100%; display: flex; background-color: rgba(0, 0, 0, 0); align-self: auto; align-items: stretch; align-content: auto; justify-content: flex-start; flex-direction: row; -unity-slice-right: 0;">
            <ui:VisualElement name="gadget-tooltip" class="animated-tooltip" style="flex-grow: 1; flex-direction: column; flex-wrap: wrap; align-self: center; align-content: center; align-items: center; justify-content: flex-start; background-color: rgba(255, 255, 255, 0); flex-shrink: 1; flex-basis: 0%; width: 210px; height: 115px; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; position: absolute; top: 523px; left: 547px; background-image: url(&quot;project://database/Assets/Graphics%202D/UI%20tunnel/Co%C5%9B.PNG?fileID=2800000&amp;guid=e3a836109981a4144a4bf211a5372bea&amp;type=3#Co&#347;&quot;); -unity-slice-left: 120; -unity-slice-top: 120; -unity-slice-right: 120; -unity-slice-bottom: 120; -unity-background-image-tint-color: rgb(174, 174, 174); display: none;">
                <ui:Label text="UNKNOWN" name="gadget-name" style="align-self: center; align-items: center; justify-content: center; align-content: center; font-size: 18px; -unity-text-align: middle-center; -unity-font-style: bold; flex-grow: 0; flex-shrink: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 9%; margin-right: 10%; margin-bottom: 3%; margin-left: 10%; width: 162px; white-space: normal; height: 38px;"/>
                <ui:Label text="PRESS RMB TO SCAN" name="gadget-description" style="font-size: 12px; margin-top: 5px; margin-right: 15px; margin-bottom: 5px; margin-left: 15px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; white-space: normal; width: 178px; -unity-text-align: upper-center; height: 46px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

    <Style src="project://database/Assets/UI%20Toolkit/UXML%20&amp;%20Styles/_Styles/Global%20Typography.uss?fileID=7433441132597879392&amp;guid=3a9abda79df507e4282cecd0ce8fdfb0&amp;type=3#Global Typography"/>
    <ui:VisualElement name="panel" style="align-self: auto; align-content: auto; flex-grow: 1; flex-shrink: 1;">
        <ui:VisualElement name="background" style="flex-grow: 0; background-color: rgba(88, 79, 25, 0); width: 80%; height: 80%; justify-content: space-evenly; align-self: center; align-content: stretch; align-items: stretch; top: 100px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; flex-direction: row; flex-shrink: 0; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/Map%20&amp;%20Events/Event_T%C5%82o.PNG?fileID=2800000&amp;guid=674b11a6a48ab29418b6dd518737fd23&amp;type=3#Event_T&#322;o&quot;); -unity-slice-left: 188; -unity-slice-top: 188; -unity-slice-right: 188; -unity-slice-bottom: 188;">
            <ui:VisualElement name="left-container" style="flex-grow: 1; align-content: center; align-items: stretch; justify-content: space-evenly; align-self: stretch;">
                <ui:VisualElement name="icon" style="flex-grow: 0; align-self: center; align-content: center; align-items: center; justify-content: flex-end; width: 500px; height: 500px; left: 55px; background-color: rgba(0, 0, 0, 0); border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="right-container" style="flex-grow: 1;">
                <ui:Label text="EVENT TITLE" name="event-title" style="align-self: center; align-content: center; justify-content: center; align-items: center; font-size: 65px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; width: 900px; height: 175px; padding-right: 70px; color: rgb(255, 244, 230); top: 35px;"/>
                <ui:Label text="event event event. Magic has happend. What do you do?" name="event-description" style="align-self: center; align-content: center; justify-content: center; align-items: center; font-size: 28px; -unity-font-style: normal; -unity-text-align: upper-center; white-space: normal; width: 860px; height: 264px; color: rgb(255, 244, 230); margin-right: 26px; margin-top: 10px;"/>
                <ui:DropdownField label="Who should take action? " name="robot-dropdown" class="custom-robot-dropdown"/>
                <ui:VisualElement name="event-options" style="flex-grow: 0; margin-left: 50px; align-self: auto; align-content: flex-start; justify-content: flex-start; bottom: 0; top: 0;">
                    <ui:Button text="    Button" name="option-1" style="align-items: center; align-self: flex-start; align-content: center; width: 750px; background-color: rgba(255, 255, 255, 0); color: rgb(209, 208, 204); font-size: 25px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; -unity-text-align: middle-left; justify-content: flex-start; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/Map%20&amp;%20Events/Okno_wybor%C3%B3w.PNG?fileID=2800000&amp;guid=b3384c6617274914b9b5733c72795ef9&amp;type=3#Okno_wybor&#243;w&quot;); height: 65px;"/>
                    <ui:Button text="    Button" name="option-2" style="align-items: center; align-self: flex-start; align-content: center; width: 750px; background-color: rgba(74, 63, 1, 0); color: rgb(209, 208, 204); font-size: 25px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; -unity-text-align: middle-left; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/Map%20&amp;%20Events/Okno_wybor%C3%B3w.PNG?fileID=2800000&amp;guid=b3384c6617274914b9b5733c72795ef9&amp;type=3#Okno_wybor&#243;w&quot;); height: 65px;"/>
                    <ui:Button text="    Button" name="option-3" style="align-items: center; align-self: flex-start; align-content: center; width: 750px; background-color: rgba(74, 63, 1, 0); color: rgb(209, 208, 204); font-size: 25px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-left-color: rgba(55, 47, 0, 0); border-right-color: rgba(55, 47, 0, 0); border-top-color: rgba(55, 47, 0, 0); border-bottom-color: rgba(55, 47, 0, 0); margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; -unity-text-align: middle-left; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/Map%20&amp;%20Events/Okno_wybor%C3%B3w.PNG?fileID=2800000&amp;guid=b3384c6617274914b9b5733c72795ef9&amp;type=3#Okno_wybor&#243;w&quot;); text-overflow: clip; height: 65px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="" name="btn-close" style="border-top-left-radius: 127px; border-top-right-radius: 127px; border-bottom-right-radius: 127px; border-bottom-left-radius: 127px; border-left-color: rgba(72, 72, 72, 0); border-right-color: rgba(72, 72, 72, 0); border-top-color: rgba(72, 72, 72, 0); border-bottom-color: rgba(72, 72, 72, 0); background-color: rgba(27, 27, 27, 0); color: rgb(255, 244, 232); width: 40px; height: 40px; margin-top: 23px; margin-right: 23px; margin-bottom: 23px; margin-left: 23px; align-self: flex-start; position: absolute; top: 132px; left: 1612px; align-items: auto; align-content: center; justify-content: flex-start; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/General/X.PNG?fileID=2800000&amp;guid=cb89d58f426c8b549a79aa764ec1ad30&amp;type=3#X&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; display: none;"/>

.standard-tab-gadgets:hover {
    background-image: url("project://database/Assets/Graphics%202D/Restroom/Crafting/P%C5%82ytka%201.PNG?fileID=21300000&guid=9a3573248a70dff4f9ed765962b51270&type=3#Płytka 1");

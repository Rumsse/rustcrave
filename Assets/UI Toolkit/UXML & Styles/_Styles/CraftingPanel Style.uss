VisualElement {
}

.unit-container {
    align-items: auto;
    align-self: center;
    justify-content: center;
    align-content: flex-start;
    width: 90px;
    height: 90px;
    margin-top: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    margin-left: 15px;
}

.craft-btn {
}

.standard-tab-robots {
    background-color: rgba(92, 82, 26, 0);
    background-image: url("project://database/Assets/Graphics%202D/Restroom/Crafting/P%C5%82ytka.PNG?fileID=2800000&guid=6f46fc8d00a599c49afdd1bc9c89068a&type=3#Płytka");
    border-top-left-radius: 10%;
    border-top-right-radius: 10%;
    border-bottom-right-radius: 10%;
    border-bottom-left-radius: 10%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 20px;
    margin-right: 40px;
    margin-bottom: 20px;
    margin-left: 40px;
    aspect-ratio: 1;
    width: auto;
    height: auto;
    justify-content: center;
    align-self: center;
    align-content: center;
    flex-grow: 1;
    font-size: 40px;
    align-items: stretch;
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
}

.standard-tab-robots:hover {
    background-image: url("project://database/Assets/Graphics%202D/Restroom/Crafting/P%C5%82ytka%201.PNG?fileID=21300000&guid=9a3573248a70dff4f9ed765962b51270&type=3#Płytka 1");
    color: rgb(37, 37, 37);
}

.standard-tab-robots:active {
    background-image: url("project://database/Assets/Graphics%202D/Restroom/Crafting/P%C5%82ytka%202.PNG?fileID=21300000&guid=bf6de79d5567a0c40b8a7d4e38ef624d&type=3#Płytka 2");
    color: rgb(18, 18, 18);
}


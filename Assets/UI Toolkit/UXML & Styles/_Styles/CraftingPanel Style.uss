.standard-btn-craft-gadget {
    flex-shrink: 1;
    width: 90px;
    height: 90px;
    background-color: rgb(0, 0, 0);
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 20px;
    color: rgb(255, 244, 232);
}

.standard-gear-btn {
    flex-shrink: 1;
    width: 120px;
    height: 120px;
    background-color: rgba(0, 0, 0, 0);
    font-size: 20px;
    color: rgb(255, 244, 232);
    background-image: url("project://database/Assets/Graphics%202D/Restroom/General/Z%C4%99batka.PNG?fileID=2800000&guid=b925647b772ca984f8c8632b42dd99ff&type=3#Zębatka");
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    flex-grow: 1;
    border-top-left-radius: 75px;
    border-top-right-radius: 75px;
    border-bottom-right-radius: 75px;
    border-bottom-left-radius: 75px;
}

.standard-gear-btn:hover {
    scale: 1.05;
}

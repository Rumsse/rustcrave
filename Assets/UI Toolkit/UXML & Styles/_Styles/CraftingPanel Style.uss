    border-bottom-right-radius: 10%;
    border-bottom-left-radius: 10%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 20px;
    margin-right: 15px;
    margin-bottom: 20px;
    margin-left: 40px;
    aspect-ratio: 1;
    width: auto;
    height: auto;

            </ui:VisualElement>
            <ui:VisualElement name="bottom-section" style="flex-grow: 1; width: 100%; height: 23%; flex-shrink: 1; align-content: flex-end; justify-content: flex-end; align-items: center; align-self: auto; margin-bottom: 32px;">
                <ui:Label text="You have:" name="Label" style="align-self: center; align-content: flex-start; align-items: center; justify-content: center; -unity-font-style: bold; font-size: 20px; color: rgb(171, 151, 119); -unity-font-definition: url(&quot;project://database/Assets/Free%20Assets/Fonts/FhaCondensedFrenchNc-O2n3%20SDF%201.asset?fileID=11400000&amp;guid=6b5bfbd6dafc19d4e9983ca25d6da867&amp;type=2#FhaCondensedFrenchNc-O2n3 SDF 1&quot;); margin-bottom: 1px;"/>
                <ui:VisualElement name="resource-bar" style="flex-grow: 0; flex-direction: row; align-content: center; height: 25%; flex-wrap: nowrap; align-self: center; justify-content: center; align-items: center; width: 100%; left: auto;">
                    <ui:VisualElement name="resource-sparklite" data-source-path="" class="resource-item">
                        <ui:VisualElement name="icon" class="resource-icon resource-icon-spark"/>
                        <ui:Label text="0" name="amount" class="resource-amount">
                            <Bindings>

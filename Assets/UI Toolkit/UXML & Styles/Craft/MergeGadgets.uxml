        <ui:VisualElement name="gadgets-info-panel" style="flex-grow: 1; position: absolute; width: 400px; height: 150px; margin-top: 40px; background-color: rgba(82, 60, 41, 0); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; display: none; right: auto; align-self: center; align-content: auto; align-items: auto; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/Crafting/Okienko_do_Craftu_1.PNG?fileID=2800000&amp;guid=3fc626de5072ec94f89a9716f2e3fecc&amp;type=3#Okienko_do_Craftu_1&quot;); -unity-slice-left: 30; -unity-slice-top: 30; -unity-slice-right: 30; -unity-slice-bottom: 30;">
            <ui:Label text="You can craft gadgets and assign them to your swarm unit in swarm panel. A gadget adds a particular additional value to the base stat value of a unit. You can always change the assigned gadgets of your unit and assign them to another later." name="info-text" style="font-size: 14px; align-self: center; align-content: stretch; flex-direction: row; flex-wrap: wrap; white-space: normal; color: rgb(197, 178, 148); justify-content: space-evenly; flex-grow: 1; margin-top: 15px; margin-right: 25px; margin-bottom: 15px; margin-left: 30px; -unity-font-style: normal;"/>
        </ui:VisualElement>
        <ui:Button text="" name="btn-back-gadgets" class="btn-back" style="position: absolute; top: 10px; left: 701px;"/>

    <Style src="project://database/Assets/UI%20Toolkit/UXML%20&amp;%20Styles/_Styles/Global%20Typography.uss?fileID=7433441132597879392&amp;guid=3a9abda79df507e4282cecd0ce8fdfb0&amp;type=3#Global Typography"/>
    <ui:VisualElement name="gadgets" picking-mode="Ignore" style="flex-grow: 1; background-color: rgba(74, 63, 1, 0); align-content: center; align-items: stretch; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/Crafting/T%C5%82o_Crafting.PNG?fileID=2800000&amp;guid=78f004ca403aca44ea56fc1453454447&amp;type=3#T&#322;o_Crafting&quot;); flex-wrap: wrap; align-self: center; flex-direction: row; width: 100%; height: 100%; flex-shrink: 0;">
        <ui:VisualElement name="right-bar" style="flex-grow: 1; height: 100%; width: 100%; align-items: center; align-self: center; flex-direction: column; flex-wrap: nowrap; flex-shrink: 0;">
            <ui:VisualElement name="upper-section" style="flex-grow: 1; width: 100%; height: 20%; flex-shrink: 1; align-self: auto; align-content: center; align-items: flex-start; justify-content: center; flex-direction: row;">
                <ui:Label text="MERGE GADGETS" name="header" style="align-self: auto; align-content: center; align-items: center; justify-content: center; font-size: 55px; -unity-text-align: middle-center; -unity-font-style: bold; width: 685px; height: 80px; margin-top: 55px; color: rgb(171, 151, 119);">
                    <ui:Button text="" name="btn-info-gadgets" style="border-left-color: rgba(87, 83, 64, 0); border-right-color: rgba(87, 83, 64, 0); border-top-color: rgba(87, 83, 64, 0); border-bottom-color: rgba(87, 83, 64, 0); border-top-left-radius: 46px; border-top-right-radius: 46px; border-bottom-right-radius: 46px; border-bottom-left-radius: 46px; align-items: flex-end; align-self: flex-end; align-content: center; flex-shrink: 1; width: 30px; height: 30px; font-size: 35px; color: rgb(0, 0, 0); background-color: rgba(94, 90, 68, 0); margin-right: 25px; justify-content: center; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/General/_.PNG?fileID=2800000&amp;guid=8408f9c08e5b5914aafafb738fbcdb47&amp;type=3#_&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-bottom: 12px;"/>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement name="middle-section" style="flex-grow: 1; width: 100%; height: 100%; flex-shrink: 1; flex-direction: column; flex-wrap: wrap; align-content: flex-start;">
                <ui:VisualElement name="gadgets-popup" style="flex-grow: 0; width: 650px; height: 120px; background-color: rgba(116, 105, 33, 0); border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; display: flex; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/Crafting/Rura_z_lewej%20(1).PNG?fileID=2800000&amp;guid=454746b71dc08504d89653f781d4393b&amp;type=3#Rura_z_lewej (1)&quot;); -unity-slice-type: sliced; -unity-slice-left: 1400; -unity-slice-top: 1400; -unity-slice-right: 1400; -unity-slice-bottom: 1400; align-self: center; justify-content: space-around; align-items: center; align-content: center; margin-top: 70px; margin-right: 30px; margin-bottom: 30px; margin-left: 30px;">
                    <ui:ScrollView name="gadgets-list-container" style="flex-wrap: wrap; flex-direction: column; display: flex; height: 204px; flex-grow: 1; align-items: center; justify-content: flex-end; align-self: auto; align-content: center;"/>
                    <ui:Button text="" name="btn-close-popup" style="border-top-left-radius: 127px; border-top-right-radius: 127px; border-bottom-right-radius: 127px; border-bottom-left-radius: 127px; border-left-color: rgba(72, 72, 72, 0); border-right-color: rgba(72, 72, 72, 0); border-top-color: rgba(72, 72, 72, 0); border-bottom-color: rgba(72, 72, 72, 0); background-color: rgba(27, 27, 27, 0); color: rgb(255, 244, 232); width: 20px; height: 22px; margin-top: 23px; margin-right: 23px; margin-bottom: 23px; margin-left: 23px; align-self: flex-start; position: absolute; top: -21px; left: -21px; align-items: auto; align-content: center; justify-content: flex-start; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/General/X.PNG?fileID=2800000&amp;guid=cb89d58f426c8b549a79aa764ec1ad30&amp;type=3#X&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                </ui:VisualElement>
                <ui:VisualElement name="container-kinetic" style="flex-grow: 1; align-self: auto; align-content: center; justify-content: center; align-items: auto; flex-wrap: wrap;">
                    <ui:VisualElement name="craft-btn" style="background-color: rgba(92, 82, 26, 0); border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; flex-direction: row; flex-wrap: wrap; align-self: center; align-content: center; align-items: center; flex-grow: 0; flex-shrink: 1; justify-content: flex-start; width: 685px; height: 100px; top: 20px; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/Crafting/Okienko_do_Craftu_1.PNG?fileID=2800000&amp;guid=3fc626de5072ec94f89a9716f2e3fecc&amp;type=3#Okienko_do_Craftu_1&quot;); border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0);">
                        <ui:VisualElement name="name" style="flex-grow: 0; flex-shrink: 0; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/Crafting/Okienko_do_Craftu_2.PNG?fileID=2800000&amp;guid=34717594fd1f5684fb37a947b8a6ae41&amp;type=3#Okienko_do_Craftu_2&quot;); margin-left: 45px; width: 175px; height: 100px;">
                            <ui:VisualElement name="gadget-chosen-1" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/Crafting/Gadgets%20Icons/I_Copper_Sheets.PNG?fileID=2800000&amp;guid=8a3fda8c6d841a54598d574dd698a38b&amp;type=3#I_Copper_Sheets&quot;); flex-shrink: 0; width: 90px; height: 90px; align-self: center; justify-content: center; align-content: center;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="plus" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Free%20Assets/Icons/SkymonIconPackFree/skymon-icons-white/plus.png?fileID=2800000&amp;guid=b39ccdf2015654b45b55960c0227e7d9&amp;type=3#plus&quot;); flex-shrink: 0; justify-content: center; align-self: center; align-content: center; width: 40px; height: 40px; margin-left: 30px; margin-right: 30px; -unity-background-image-tint-color: rgb(168, 144, 102);"/>
                        <ui:VisualElement name="resources" style="flex-grow: 0; flex-shrink: 0; width: 175px; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/Crafting/Okienko_do_Craftu_3.PNG?fileID=2800000&amp;guid=593148d3c054c3c4593a689f4b4b248d&amp;type=3#Okienko_do_Craftu_3&quot;); background-size: 100% 100%; margin-left: 0; height: 100px; align-self: center; align-content: center; justify-content: center; align-items: stretch;">
                            <ui:VisualElement name="gadget-chosen-2" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Graphics%202D/Restroom/Crafting/Gadgets%20Icons/I_Copper_Sheets.PNG?fileID=2800000&amp;guid=8a3fda8c6d841a54598d574dd698a38b&amp;type=3#I_Copper_Sheets&quot;); flex-shrink: 0; width: 90px; height: 90px; align-self: center; justify-content: center; align-content: center;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="gear" style="flex-grow: 1; flex-shrink: 1; align-self: center; align-content: center; align-items: stretch; justify-content: center;">
                            <ui:VisualElement name="craft" style="flex-grow: 0; flex-direction: row; flex-wrap: nowrap; background-color: rgba(0, 0, 0, 0); background-image: url(&quot;project://database/Assets/Free%20Assets/Particles/UnityTechnologies/ParticlePack/EffectExamples/Misc%20Effects/Textures/DustMote.png?fileID=2800000&amp;guid=394e93ce356b57344903a08ff72fcab2&amp;type=3#DustMote&quot;); -unity-background-image-tint-color: rgba(31, 31, 31, 0.6); background-size: 155% 155%; flex-shrink: 0; margin-right: 15px; align-items: center; justify-content: center; align-self: center; align-content: center;">
                                <ui:Button text="" name="btn-craft-kinetic" class="standard-gear-btn"/>
                            </ui:VisualElement>

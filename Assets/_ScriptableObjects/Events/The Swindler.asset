%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f347c9dca12e0464da81ba9e3d41a00e, type: 3}
  m_Name: The Swindler
  m_EditorClassIdentifier: Assembly-CSharp::RandomEvent
  eventTitle: THE SWINDLER
  eventIcon: {fileID: 21300000, guid: ba9192bae9c0d5a489bcb4141a7a645b, type: 3}
  eventDescription: 'A shady, cloaked automaton beckons you from the shadows. It
    points to your resource bags, flashing a few rare components and offering a high-stakes
    gamble.


    What do you do?'
  dialogOptions:
  - optionText: '    Hand over all your resources'
    isIgnoreOption: 0
    isLuckCheck: 1
    baseSuccessChance: 30
    isMiningCheck: 0
    bonusPerMiningPower: 0
    isAttackCheck: 0
    bonusPerDamage: 0
    successOutcome:
      resultText: "The Swindler works its mechanical magic, processes the materials,
        and hands you back a heavy sack! \n\nYour resources are doubled!"
      actions:
      - {fileID: 11400000, guid: daac291cfeb22004a84e6d24933f6181, type: 2}
    failureOutcome:
      resultText: "The Swindler laughs mechanically, drops a smoke bomb, and vanishes
        with everything you had! \n\nYou lose all your resources."
      actions:
      - {fileID: 11400000, guid: 29e6e5689c9826b4aab1629db62ce2d6, type: 2}
  - optionText: '    I order ___ to attack the Swindler!'
    isIgnoreOption: 0
    isLuckCheck: 0
    baseSuccessChance: 30
    isMiningCheck: 0
    bonusPerMiningPower: 0
    isAttackCheck: 1
    bonusPerDamage: 10
    successOutcome:
      resultText: "___ strikes fast, pinning the Swindler down and tearing its stash
        away before it can escape! \n\nYou receive 1 Random Gadget and 2 of each
        resource (Scraponite, Sparklite, Pulsite)."
      actions:
      - {fileID: 11400000, guid: 80d9c91a11eb1be46ae38d02f21baaee, type: 2}
      - {fileID: 11400000, guid: 07408030fc9cc75438b3e1ef3cb8efe5, type: 2}
      - {fileID: 11400000, guid: 61e6f0e576e74584c9b22f340faefeb8, type: 2}
      - {fileID: 11400000, guid: 5ba1a516aa2e9a243ba84b7ec2126fe7, type: 2}
    failureOutcome:
      resultText: 'The Swindler is too quick! He dodges your attack ___ and vanishes
        into the shadows, stealing the scraps from your pocket!


        You lose
        your entire randomly picked resource.'
      actions:
      - {fileID: 11400000, guid: a3486f44c853d4a438bd7c7d2eb0c717, type: 2}
  - optionText: '    Ignore'
    isIgnoreOption: 1
    isLuckCheck: 0
    baseSuccessChance: 30
    isMiningCheck: 0
    bonusPerMiningPower: 0
    isAttackCheck: 1
    bonusPerDamage: 10
    successOutcome:
      resultText: "___ strikes fast, pinning the Swindler down and tearing its stash
        away before it can escape! \n\nYou receive 1 Random Gadget and 2 of each
        resource (Scraponite, Sparklite, Pulsite)."
      actions:
      - {fileID: 11400000, guid: daac291cfeb22004a84e6d24933f6181, type: 2}
    failureOutcome:
      resultText: 'The Swindler is too quick! He dodges your attack ___ and vanishes
        into the shadows, stealing the scraps from your pocket!


        You lose
        your entire random resource.'
      actions:
      - {fileID: 11400000, guid: 29e6e5689c9826b4aab1629db62ce2d6, type: 2}

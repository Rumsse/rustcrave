  m_Script: {fileID: 11500000, guid: f347c9dca12e0464da81ba9e3d41a00e, type: 3}
  m_Name: The Bio-Mechanical Egg
  m_EditorClassIdentifier: Assembly-CSharp::RandomEvent
  eventTitle: THE BIO-MECHANICAL EGG
  eventIcon: {fileID: 21300000, guid: 54630d81cb166ff46bb2ef2dd87bb859, type: 3}
  eventDescription: 'A pulsating, fleshy egg intertwined with copper wires rests
    in the corner. It hums with a strange, biological frequency.


    What do you
    do?'
  dialogOptions:
  - optionText: '    I order ___ to carefully pick it up.'
    isIgnoreOption: 0
    check:
      rid: 2077119951850176535
    successOutcome:
      resultText: ___ secures the egg. It acts as a strange parasite, adding +2 inventory
        slots to ___.
      keepEventActive: 0
      actions:
      - rid: 2077119951850176536
    failureOutcome:
      resultText: "As ___ touches it, the egg rots and dissolves into a puddle of
        foul-smelling, harmless sludge. \n\nNothing happens."
      keepEventActive: 0
      actions: []
    requirements: []
  - optionText: '    I order ___ to destroy the egg!'
    isIgnoreOption: 0
    check:
      rid: 2077119951850176537
    successOutcome:
      resultText: "___ smashes the egg open! Inside, you find undigested, valuable
        materials. \n\nYou gain 4 to 7 Random Resources!"
      keepEventActive: 0
      actions:
      - rid: 2077119951850176539
    failureOutcome:
      resultText: "The egg is highly volatile! \n\nIt explodes violently upon impact,
        covering ___ in acidic slime. ___ takes 4 DMG!"
      keepEventActive: 0
      actions:
      - rid: 2077119951850176540
    requirements: []
  - optionText: '    Ignore'
    isIgnoreOption: 1
    check:
      rid: 2077119951850176522
    successOutcome:
      resultText: "___ strikes fast, pinning the Swindler down and tearing its stash
        away before it can escape! \n\nYou receive 1 Random Gadget and 2 of each
        resource (Scraponite, Sparklite, Pulsite)."
      keepEventActive: 0
      actions:
      - rid: -2
    failureOutcome:
      resultText: 'The Swindler is too quick! He dodges your attack ___ and vanishes
        into the shadows, stealing the scraps from your pocket!


        You lose
        your entire random resource.'
      keepEventActive: 0
      actions:
      - rid: -2
    requirements: []
  references:
    version: 2
    RefIds:

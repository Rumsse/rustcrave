  m_Script: {fileID: 11500000, guid: f347c9dca12e0464da81ba9e3d41a00e, type: 3}
  m_Name: The Dead Courier
  m_EditorClassIdentifier: Assembly-CSharp::RandomEvent
  eventTitle: THE DEAD COURIER
  eventIcon: {fileID: 21300000, guid: e13ae88d40b31ef42b2866b37eb60cd6, type: 3}
  eventDescription: 'Half-buried under a pile of rubble lies the crushed chassis
    of an ancient courier drone. Its mechanical claws are still tightly clutching
    a sealed titanium lockbox.


    What do you do?'
  dialogOptions:
  - optionText: '    I order ___ to pry it open with brute force!'
    isIgnoreOption: 0
    check:
      rid: 2077119951850176604
    successOutcome:
      resultText: "The hinges snap under the sheer mechanical force! \n\nYou receive
        1 Random Gadget and 4 Scraponite."
      keepEventActive: 0
      actions:
      - rid: 2077119951850176605
      - rid: 2077119951850176607
    failureOutcome:
      resultText: "The box is booby-trapped! It explodes right in ___'s face. \n\n___
        takes 2 DMG."
      keepEventActive: 0
      actions:
      - rid: 2077119951850176608
    requirements: []
  - optionText: '    I order ___ to pick the lock precisely'
    isIgnoreOption: 0
    check:
      rid: 2077119951850176609
    successOutcome:
      resultText: "___'s fine manipulators snap the locking mechanism without triggering
        the failsafe. \n\nYou receive 1 Random Gadget!"
      keepEventActive: 0
      actions:
      - rid: 2077119951850176610
    failureOutcome:
      resultText: "A wrong wire is cut, and the lockbox's internal incinerator activates!
        The contents are reduced to useless ash. \n\nYou get nothing."
      keepEventActive: 0
      actions: []
    requirements: []
  - optionText: '    Ignore'
    isIgnoreOption: 1
    check:
      rid: 2077119951850176603
    successOutcome:
      resultText: 
      keepEventActive: 0
      actions: []
    failureOutcome:
      resultText: 
      keepEventActive: 0
      actions: []
    requirements: []

  m_Script: {fileID: 11500000, guid: f347c9dca12e0464da81ba9e3d41a00e, type: 3}
  m_Name: The Mirror Chamber
  m_EditorClassIdentifier: Assembly-CSharp::RandomEvent
  eventTitle: THE MIRROR CHAMBER
  eventIcon: {fileID: 21300000, guid: 753834bbb41f9a143bb9701adf629d6a, type: 3}
  eventDescription: 'You discover a forgotten chamber lined with tall, shimmering
    liquid mirrors. The central apparatus hums to life, its ancient scanners attempting
    to mysteriously analyze any machine that dares to step inside.


    What do
    you do?'
  dialogOptions:
  - optionText: '    I order ___ to step into the scanner.'
    isIgnoreOption: 0
    check:
      rid: 5683521885328637952
    successOutcome:
      resultText: The scanner whirs and flashes a blinding blue light. A perfect,
        pristine replica of ___ steps out of the mirror to join your swarm!
      keepEventActive: 0
      actions:
      - rid: 5683521885328637955
    failureOutcome:
      resultText: The mirrors glitch and shatter! The strange biological energies
        violently drain ___'s power reserves before the machine shuts down permanently.
      keepEventActive: 0
      actions:
      - rid: 5683521885328637957
    requirements: []
  - optionText: '    I order ___ to carefully pump and carry the heavy liquid mirrors.'
    isIgnoreOption: 0
    check:
      rid: 5683521885328637960
    successOutcome:
      resultText: ___ successfully utilizes its storage compartments to safely contain
        the dense, valuable liquid! You extract rare materials from the substance.
      keepEventActive: 0
      actions:
      - rid: 5683521885328637959
    failureOutcome:
      resultText: The liquid is incredibly heavy and volatile! It bursts out of ___'s
        storage tanks, causing a violent chemical explosion that damages everyone
        except The Conductor!
      keepEventActive: 0
      actions:
      - rid: 5683521885328637961
    requirements: []
  - optionText: '    Ignore'
    isIgnoreOption: 1
    check:
      rid: 5683521885328637954
    successOutcome:
      resultText: "The machine seals shut and whirs loudly, violently rewriting ___'s
        code! \n\nEvery core stat (Max HP, Max Energy, DMG, DIG, Speed) is permanently
        and individually modified by +1 or -1."
      keepEventActive: 0
      actions:
      - rid: -2
    failureOutcome:
      resultText: 
      keepEventActive: 0
      actions: []
    requirements: []
  references:
    version: 2

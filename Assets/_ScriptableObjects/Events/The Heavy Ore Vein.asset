  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f347c9dca12e0464da81ba9e3d41a00e, type: 3}
  m_Name: The Heavy Ore Vein
  m_EditorClassIdentifier: Assembly-CSharp::RandomEvent
  eventTitle: THE HEAVY ORE VEIN
  eventIcon: {fileID: 21300000, guid: 5310f41bccf86c0499831e1642d279e6, type: 3}
  eventDescription: "A massive, abnormally dense vein of raw Scraponite is embedded
    in the cavern wall. It\u2019s too large to mine with standard methods without
    causing a cave-in.\n\nWhat do you do?"
  dialogOptions:
  - optionText: '    I order ___ to shatter it with one massive strike!'
    isIgnoreOption: 0
    isLuckCheck: 0
    baseSuccessChance: 40
    isMiningCheck: 0
    bonusPerMiningPower: 10
    isAttackCheck: 1
    bonusPerDamage: 10
    successOutcome:
      resultText: '___ delivers a devastating blow, shattering the vein perfectly
        and revealing a hidden geode!


        You gain 4-6 Scraponite.'
      keepEventActive: 0
      actions:
      - {fileID: 11400000, guid: 7f8657a158322d449a7d91d44eddd54c, type: 2}
    failureOutcome:
      resultText: 'The brutal strike causes a localized collapse, burying the entire
        vein under tons of useless rubble.


        Everyone takes 2 DMG!'
      keepEventActive: 0
      actions:
      - {fileID: 11400000, guid: 60f3e24778620234ea4dbe0431f98a42, type: 2}
  - optionText: '    I order ___ to carefully chip away at the edges.'
    isIgnoreOption: 0
    isLuckCheck: 0
    baseSuccessChance: 50
    isMiningCheck: 1
    bonusPerMiningPower: 10
    isAttackCheck: 0
    bonusPerDamage: 10
    successOutcome:
      resultText: "___ grounds itself and absorbs the wild energy perfectly! \n\n___
        restores 50% Energy and gains +1 Max Energy for the rest of the run."
      keepEventActive: 0
      actions:
      - {fileID: 11400000, guid: a1424a64057dcab4c917269329c1f0f3, type: 2}
      - {fileID: 11400000, guid: 3da0e2df671f88643b6e94ef458f3a85, type: 2}
    failureOutcome:
      resultText: 'The vibrations destabilize the ceiling! A heavy chunk of rock
        falls directly onto ___''s chassis.


        ___ takes 2 DMG.'
      keepEventActive: 0
      actions:
      - {fileID: 11400000, guid: f4836e2eae1361143a86f8a97addf0be, type: 2}
  - optionText: '    Ignore'
    isIgnoreOption: 1
    isLuckCheck: 0
    baseSuccessChance: 50
    isMiningCheck: 0
    bonusPerMiningPower: 10
    isAttackCheck: 0
    bonusPerDamage: 10
    successOutcome:
      resultText: 
      keepEventActive: 0
      actions: []
    failureOutcome:
      resultText: 
      keepEventActive: 0
      actions: []

  m_Script: {fileID: 11500000, guid: f347c9dca12e0464da81ba9e3d41a00e, type: 3}
  m_Name: The Heavy Ore Vein
  m_EditorClassIdentifier: Assembly-CSharp::RandomEvent
  eventTitle: THE HEAVY ORE VEIN
  eventIcon: {fileID: 21300000, guid: 5310f41bccf86c0499831e1642d279e6, type: 3}
  eventDescription: "A massive, abnormally dense vein of raw Scraponite is embedded
    in the cavern wall. It\u2019s too large to mine with standard methods without
    causing a cave-in.\n\nWhat do you do?"
  dialogOptions:
  - optionText: '    I order ___ to shatter it with massive strike!'
    isIgnoreOption: 0
    check:
      rid: 2077119951850176611
    successOutcome:
      resultText: '___ delivers a devastating blow, shattering the vein perfectly
        and revealing a hidden geode!


        You gain 6-9 Scraponite.'
      keepEventActive: 0
      actions:
      - rid: 2077119951850176612
    failureOutcome:
      resultText: 'The brutal strike causes a localized collapse, burying the entire
        vein under tons of useless rubble.


        Everyone takes 2 DMG!'
      keepEventActive: 0
      actions:
      - rid: 2077119951850176613
    requirements: []
  - optionText: '    I order ___ to carefully chip away the edges.'
    isIgnoreOption: 0
    check:
      rid: 2077119951850176614
    successOutcome:
      resultText: "___ grounds itself and absorbs the wild energy perfectly! \n\n___
        restores 50% Energy and gains +20 Max Energy for the rest of the run."
      keepEventActive: 0
      actions:
      - rid: 2077119951850176615
      - rid: 2077119951850176617
    failureOutcome:
      resultText: 'The vibrations destabilize the ceiling! A heavy chunk of rock
        falls directly onto ___''s chassis.


        ___ takes 2 DMG.'
      keepEventActive: 0
      actions:
      - rid: 2077119951850176618
    requirements: []
  - optionText: '    Ignore'
    isIgnoreOption: 1
    check:
      rid: 2077119951850176517
    successOutcome:
      resultText: 
      keepEventActive: 0
      actions: []
    failureOutcome:
      resultText: 
      keepEventActive: 0
      actions: []
    requirements: []

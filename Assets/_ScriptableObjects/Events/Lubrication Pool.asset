  m_Name: Lubrication Pool
  m_EditorClassIdentifier: Assembly-CSharp::RandomEvent
  eventTitle: THE LUBRICATION POOL
  eventIcon: {fileID: 21300000, guid: 560762bb26dee084c8084ed538dd41e8, type: 3}
  eventDescription: 'You stumble upon a basin filled with thick, luminescent mechanical
    oil. It looks perfectly preserved and could do wonders for rusted joints, but
    it might be contaminated with acid.


    What do you do?'
  dialogOptions:
  - optionText: '    I order ___ to submerge in the pool.'
    isIgnoreOption: 0
    check:
      rid: 7221758598679363709
    successOutcome:
      resultText: "The high-grade oil clears out the rust and seals the micro-fractures
        in the armour. \n\n___ is fully repaired!"
      keepEventActive: 0
      actions:
      - rid: 7221758598679363712
    failureOutcome:
      resultText: "The liquid is highly corrosive industrial runoff! The armor begins
        to melt. \n\n___ Health has been set to 1!"
      keepEventActive: 0
      actions:
      - rid: 2077119951850176619
    requirements: []
  - optionText: '    Safely extract a small sample.'
    isIgnoreOption: 0
    check:
      rid: -2
    successOutcome:
      resultText: "You carefully bottle a tiny amount of the usable fluid without
        risking the machines. \n\nYou gain 3 Scraponite."
      keepEventActive: 0
      actions:
      - rid: 2077119951850176620
    failureOutcome:
      resultText: 
      keepEventActive: 0
      actions: []
    requirements: []
  - optionText: '    Ignore'
    isIgnoreOption: 1
    check:
      rid: 7221758598679363711
    successOutcome:
      resultText: 
      keepEventActive: 0
      actions: []
    failureOutcome:
      resultText: 
      keepEventActive: 0
      actions: []
    requirements: []

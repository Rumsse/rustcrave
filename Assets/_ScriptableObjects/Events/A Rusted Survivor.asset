  m_Script: {fileID: 11500000, guid: f347c9dca12e0464da81ba9e3d41a00e, type: 3}
  m_Name: A Rusted Survivor
  m_EditorClassIdentifier: Assembly-CSharp::RandomEvent
  eventTitle: A RUSTED SURVIVOR
  eventIcon: {fileID: 21300000, guid: a8f1cd40abafe4b4ca84e8e798d871a8, type: 3}
  eventDescription: 'You find a severely damaged automaton leaning against the Asylum
    wall. Its core is flickering erratically, on the verge of critical failure.


    What
    do you do?

'
  dialogOptions:
  - optionText: '    I order ___ to carefully stabilize its core.'
    isIgnoreOption: 0
    check:
      rid: 7221758439618510971
    successOutcome:
      resultText: "___ manages to bypass the corrupted circuits and stabilize the
        core just in time! The robot boots up and joins your swarm. \n\nYou receive
        1 random slighty damaged Robot."
      keepEventActive: 0
      actions:
      - rid: 2077119951850176589
    failureOutcome:
      resultText: " ___ crosses the wrong wires! The core destabilizes completely
        and detonates with a blinding flash! \n\nAll robots in the Swarm take 2 DMG,
        but Hollow Conductor avoided it. "
      keepEventActive: 0
      actions:
      - rid: 2077119951850176590
    requirements: []
  - optionText: '    I order ___ to brutally dismantle it for parts. '
    isIgnoreOption: 0
    check:
      rid: 2077119951850176591
    successOutcome:
      resultText: " ___ swiftly tears out the usable components before the core completely
        dies. \n\nYou gain 6 Scraponite and 3 Sparklite."
      keepEventActive: 0
      actions:
      - rid: 2077119951850176592
      - rid: 2077119951850176593
    failureOutcome:
      resultText: "The fragile chassis crumbles into useless dust and rusted flakes
        the moment ___ touches it. \n\nYou get nothing."
      keepEventActive: 0
      actions: []
    requirements: []
  - optionText: '    Ignore'
    isIgnoreOption: 1
    check:
      rid: 7221758439618510969
    successOutcome:
      resultText: "___ strikes fast, pinning the Swindler down and tearing its stash
        away before it can escape! \n\nYou receive 1 Random Gadget and 2 of each
        resource (Scraponite, Sparklite, Pulsite)."
      keepEventActive: 0
      actions:
      - rid: -2
    failureOutcome:
      resultText: 'The Swindler is too quick! He dodges your attack ___ and vanishes
        into the shadows, stealing the scraps from your pocket!


        You lose
        your entire random resource.'
      keepEventActive: 0
      actions:
      - rid: -2
    requirements: []
  references:
    version: 2

  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f347c9dca12e0464da81ba9e3d41a00e, type: 3}
  m_Name: The Generator
  m_EditorClassIdentifier: Assembly-CSharp::RandomEvent
  eventTitle: THE GENERATOR
  eventIcon: {fileID: 21300000, guid: bcf9033ba7e9d06488845a685207d1ad, type: 3}
  eventDescription: 'A massive, sparking generator hums loudly in the center of the
    room. It could be tapped for raw power, but the rusted wiring is dangerously
    exposed.


    What do you do?'
  dialogOptions:
  - optionText: '    Hook the Swarm up to the generator.'
    isIgnoreOption: 0
    isLuckCheck: 1
    baseSuccessChance: 70
    isMiningCheck: 0
    bonusPerMiningPower: 10
    isAttackCheck: 0
    bonusPerDamage: 10
    successOutcome:
      resultText: "The generator purrs smoothly, feeding a clean current into your
        machines! \n\nAll robots restore 33% of their Max Energy."
      actions:
      - {fileID: 11400000, guid: c93a5b4afe818054697d433210534bbd, type: 2}
    failureOutcome:
      resultText: "A massive short circuit sparks across the rusted cables! \n\nAll
        robots are violently shocked, losing 33% of their Energy."
      actions:
      - {fileID: 11400000, guid: cb07c7a5b6cb4634e92f74a85147f8f8, type: 2}
  - optionText: '    Ignore'
    isIgnoreOption: 1
    isLuckCheck: 0
    baseSuccessChance: 50
    isMiningCheck: 0
    bonusPerMiningPower: 10
    isAttackCheck: 0
    bonusPerDamage: 10
    successOutcome:
      resultText: 
      actions: []
    failureOutcome:
      resultText: 
      actions: []

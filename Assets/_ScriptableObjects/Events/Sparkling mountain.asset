  m_Name: Sparkling mountain
  m_EditorClassIdentifier: Assembly-CSharp::RandomEvent
  eventTitle: SPARKLING MOUNTAIN
  eventIcon: {fileID: 21300000, guid: dec999d0e63b9f24bb69fd7f28c6a8db, type: 3}
  eventDescription: "A huge rock emits an incredibly large amount of electricity.
    \n\nWhat do you do?"
  dialogOptions:
  - optionText: I order ___ to touch it.
    isIgnoreOption: 0
    baseSuccessChance: 50
    isMiningCheck: 0
    bonusPerMiningPower: 10
    isAttackCheck: 0
    bonusPerDamage: 10
    successOutcome:
      resultText: '___ touched it and the gears are working like never before!


        ___''s
        energy has been fully restored.

        The rock discharges itself.'
      actions:
      - {fileID: 11400000, guid: e8b3aaeefb814e24c8a3f7286af696ff, type: 2}
    failureOutcome:
      resultText: 
      actions: []
  - optionText: I order ___ to mine it.
    isIgnoreOption: 0
    baseSuccessChance: 50
    isMiningCheck: 1
    bonusPerMiningPower: 10
    isAttackCheck: 0
    bonusPerDamage: 10
    successOutcome:
      resultText: 'The rock cracks, and its energy spreads throughout the room!


        You
        receive 3 sparklite, and in addition all robots regain 10% of their energy.'
      actions:
      - {fileID: 11400000, guid: 5c8529f7e765b9042ae21ce108ce8977, type: 2}
      - {fileID: 11400000, guid: 7dae2417341a0094fb41276e25d65914, type: 2}
    failureOutcome:
      resultText: '___ strikes the rock, and it repels him with unimaginable force,
        emitting sparks!

        ___ He takes 3 DMG!


        The rock discharges
        itself.'
      actions:
      - {fileID: 11400000, guid: e8b3aaeefb814e24c8a3f7286af696ff, type: 2}

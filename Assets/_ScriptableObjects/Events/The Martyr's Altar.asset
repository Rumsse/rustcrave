  eventTitle: THE MARTYR'S ALTAR
  eventIcon: {fileID: 21300000, guid: 8107c8ce4f3e7954f8e0bfa61ddd37a1, type: 3}
  eventDescription: 'In the corner stands a dark, metal hydraulic press covered in
    old oil stains. It exudes a strange, magnetic aura, demanding a constant sacrifice
    in exchange for its mechanical benefits.



    What do you do?'
  dialogOptions:
  - optionText: '    I order ___ to step under the hydraulic press.'
    isIgnoreOption: 0
    isLuckCheck: 0
    baseSuccessChance: 0
    isMiningCheck: 0
    bonusPerMiningPower: 0
    isAttackCheck: 0
    bonusPerDamage: 0
    successOutcome:
      resultText: "The press brutally crushes ___ , but as it rises, the sacrificed
        robot breaks apart into pieces instead of succumbing to destruction! \r\n\r\n___
        is destroyed in exchange for gadgets! "
      actions:
      - {fileID: 11400000, guid: f44904e83ff0d404d9e34dbd253985a5, type: 2}
      - {fileID: 11400000, guid: f51c9eeb5455c5c4a9c606a7f7b67c2c, type: 2}
    failureOutcome:
      resultText: 
      actions: []
  - optionText: '    Ignore.'
    isIgnoreOption: 1
    isLuckCheck: 0
    baseSuccessChance: 0
    isMiningCheck: 0
    bonusPerMiningPower: 0
    isAttackCheck: 0
    bonusPerDamage: 0
    successOutcome:
      resultText: "The altar consumes ___ in a flash of blinding light, breaking
        the machine down to its core components. In return, the ancient mechanisms
        dispense a reward! \n\n___ is destroyed."

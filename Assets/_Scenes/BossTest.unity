  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "LMB - Select a unit.\n(click on the unit image on the HUD (bottom section)
    to open more detailed information panel about that particular unit. Click again
    to hide it. Hoover mouse over the gadget slot in the detailed panel to show details
    about equipped gadget)\n\nRMB - Command the selected unit to move/action \n(empty
    space = walk, object = action).\n\nWASD - Move the main character (can also be
    done with the mouse)\n\nE - Active ability of the main character. (Change between
    human and spider form)\n\nButtons 1 - 8 - Shortcut to select a unit (according
    to their order on the HUD)\n\nMoving the cursor over an object - Information
    (displayed in the upper right corner)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}

      objectReference: {fileID: 0}
    - target: {fileID: 6040056607672438406, guid: 3ddfb414c2d6e1d429b1218438d32362, type: 3}
      propertyPath: steps.Array.data[1].taskReminderText
      value: 'Order one of your swarm units to mine any mineral and pick it up [RMB
